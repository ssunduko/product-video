# four analytics questions answered live from Salesmessage data
#
# Generated by pipeline/author.mjs from an observed walk of the app.
# Holds and narration are sized from what the app ACTUALLY did, not
# from a guess — see the measured comments against each wait.
# Observed: 2026-08-09 - contacts and calls measured live; credit questions estimated at 35s
#
# Edit freely. Re-running the author overwrites it, so if you change
# a line here, change it in the trace too.
#
# BEFORE THE FIRST TAKE, dismiss the notify banner by hand on the pipeline profile.
# claude.ai shows a "Want to be notified when Claude responds?" banner during long
# generations, and while it is up BOTH the Send and Stop controls are absent from
# the DOM - Enter does nothing and the take stalls. Dismissing it once appears to
# suppress it for that profile, but productvideos/profile is a DIFFERENT profile
# from your everyday Chrome, so dismissing it there does not help the take.
# Do it in the same sitting as the sign-in step.
#
# Trimmed from the eight questions in mcp.flow. Dropped: conversations, messages,
# team response times, and "break that down by agent" - that last one answers
# "there is nothing to break down" on this account, because only one member has
# measurable conversations. Verified live on 2026-08-09.
#
# GENERATION IS SLOWER THAN NARRATION CAN COVER. After recording, fast-
# forward these spans rather than cutting them — the answer appearing on
# screen is the payoff, so a cut lands the viewer on a finished table
# they never saw arrive. tighten.mjs cannot do it (not a frozen screen):
#
#   $env:SPEEDS_MS='[[32122,42102,4],[70402,76322,4],[109722,123442,4],[147862,168002,4]]'; $env:OUT_NAME='cut.mp4'; node assemble.mjs
#
# Those offsets are predicted from the observed walk. Check them against
# assemble.mjs's gap report on the real take before committing to them.

name: assistant-analytics
description: four analytics questions answered live from Salesmessage data
target: claude-ai
intro: Salesmessage MCP Server | A demo of live analytics, asked in plain English
outro: Thanks for watching | Do you have any questions? Follow up with us any time - we are happy to help

# Stated as intent; resolved against the live DOM into the sidecar beside
# this file. Re-resolve after a redesign — this script does not change.
selectors:
  composer   = ask "the message box at the bottom of the chat where you type a question"
  generating = ask "the indicator that the assistant is still writing its reply"

beat Open the chat
  say "Salesmessage analytics, asked in plain English."
  wait @composer within 10s
  hold 2s

beat New contacts last month
  type "How many new contacts did we get last month, and how does that compare to the month before?" into @composer
  press Enter
  say "Salesmessage analytics, asked in plain English - no dashboard, no filters, no query builder."
  hold 8s
  say "Claude picks the Salesmessage connector and calls the contacts endpoint itself."
  hold 7s
  say "These are the account own numbers, read live rather than from a cached report."
  # measured 34.7s here; 21.7s of it is narrated
  wait @generating gone within 105s
  # 13.0s of this wait has no narration over it.
  # Fast-forward it at assemble time (see the SPEEDS_MS note in the header).
  say "New contacts last month, set against the month before, with the change as a percentage."
  hold 4s

beat Calls and duration
  type "How many calls did we make and receive last week, and what is our average call duration?" into @composer
  press Enter
  say "Calls next - volume in both directions, and how long they actually ran."
  hold 7s
  say "A different endpoint, chosen the same way, in the same chat."
  # measured 20.3s here; 11.4s of it is narrated
  wait @generating gone within 61s
  # 8.9s of this wait has no narration over it.
  # Fast-forward it at assemble time (see the SPEEDS_MS note in the header).
  say "Inbound and outbound call volume, with average duration in minutes and seconds."
  hold 4s

beat Credit usage by type
  type "How many credits did we use this month, broken down by type?" into @composer
  press Enter
  say "Credit usage for the month now, split by category."
  hold 5s
  say "Messages, textbot and calls, itemised, with last month alongside for scale."
  hold 7s
  say "Still the same connector - nothing new configured between any of these questions."
  # ESTIMATED 35.0s here (not measured); 18.3s of it is narrated
  wait @generating gone within 105s
  # 16.7s of this wait has no narration over it.
  # Fast-forward it at assemble time (see the SPEEDS_MS note in the header).
  say "The month total, broken down by category."
  hold 4s

beat Credits by source
  type "Break that down further by source, like broadcasts, automations, and chatbot" into @composer
  press Enter
  say "One follow-up question takes the same total apart by source."
  hold 6s
  say "Claude reconciles the source-level data against the number it already pulled."
  # ESTIMATED 35.0s here (not measured); 11.9s of it is narrated
  wait @generating gone within 105s
  # 23.1s of this wait has no narration over it.
  # Fast-forward it at assemble time (see the SPEEDS_MS note in the header).
  say "An itemised breakdown by source, reconciling to the same total."
  hold 4s
