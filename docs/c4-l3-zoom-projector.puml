@startuml c4-l3-zoom-projector
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Zoom Projector (project.mjs)
caption Level 3, container "4 · Zoom Projector".

ContainerDb(work_directory, "Work directory", "out/", "frames/, frames.json, actions.json, the per-take cursor.json and narration.json, demo.recordly, and the MP4 at each stage: raw, cut, final, final-narrated, -tight, -carded.")

Container_Boundary(zoom_projector_2, "4 · Zoom Projector") {
  Component(telemetry_reader, "Telemetry reader", "project.mjs", "Takes the cursor.json beside the newest take, cut.mp4 before raw.mp4, and keeps the clicks.")
  Component(click_clusterer, "Click clusterer", "project.mjs", "Clicks less than 2500ms apart become one region — opening a menu and picking an item is one move to the viewer, not two.")
  Component(flutter_guard, "Flutter guard", "project.mjs", "Two regions that would sit less than 800ms apart are merged, so the zoom holds instead of bouncing out and straight back in.")
  Component(region_builder, "Region builder", "project.mjs", "Starts 1200ms before the first click and ends 1600ms after the last, at depth 3, with focus clamped to 0.08..0.92 so a corner click still frames something.")
  Component(focus_track_builder, "Focus track builder", "project.mjs", "Keeps every click position in a cluster, not only the last.")
  Component(project_writer, "Project writer", "demo.recordly · JSON", "videoPath plus the regions, and it prints each region with its focus track so the framing can be reviewed before composing.")
}

Rel(work_directory, telemetry_reader, "cursor.json to")
Rel(telemetry_reader, click_clusterer, "Clicks to")
Rel(click_clusterer, flutter_guard, "Candidate regions to")
Rel(flutter_guard, region_builder, "Merged clusters to")
Rel(region_builder, focus_track_builder, "Each region to")
Rel(focus_track_builder, project_writer, "Regions with focus tracks to")
Rel(project_writer, work_directory, "Writes demo.recordly")

LAYOUT_WITH_LEGEND()
@enduml
