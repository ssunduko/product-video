@startuml c4-l3-tightener
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Tightener (tighten.mjs)
caption Level 3, container "7 · Tightener".

ContainerDb(work_directory, "Work directory", "out/ · out/{video}/{part}/", "One folder per take: out/ by default, or out/{video}/{part}/ when the build orchestrator sets DEMO_OUT, so takes never overwrite each other.")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")

Container_Boundary(tightener_2, "7 · Tightener") {
  Component(options, "Options", "tighten.mjs", "min, keep, speed, tail, xfade and the two detector floors.")
  Component(detector, "Detector", "ffmpeg freezedetect + silencedetect", "One pass, both filters.")
  Component(dead_run_intersector, "Dead-run intersector", "tighten.mjs", "Dead means frozen AND silent.")
  Component(zoom_guard, "Zoom guard", "tighten.mjs + {take}.recordly", "Zoom windows are subtracted from the dead runs outright.")
  Component(segment_planner, "Segment planner", "tighten.mjs", "Live stretches at 1x, dead ones at up to speed, never leaving less than keep of screen time.")
  Component(placement_check, "Placement check", "tighten.mjs", "Re-verifies every seam against the detected silence and the zoom list, and refuses to write if one is over either.")
  Component(renderer, "Renderer", "ffmpeg xfade + acrossfade", "Each segment is trimmed and retimed, then dissolved into the next over a fade long enough to see. atempo only ever stretches silence, so the narration itself is never pitched or hurried.")
}

Rel(work_directory, detector, "final-narrated.mp4 to")
Rel(detector, ffmpeg_ffprobe, "Runs the detection pass", "child process")
Rel(options, detector, "Noise floors to")
Rel(detector, dead_run_intersector, "Frozen and silent runs to")
Rel(options, dead_run_intersector, "Minimum run length to")
Rel(dead_run_intersector, zoom_guard, "Dead runs to")
Rel(work_directory, zoom_guard, "{take}.recordly zoom regions to")
Rel(zoom_guard, segment_planner, "Protected dead runs to")
Rel(options, segment_planner, "keep, speed and tail to")
Rel(segment_planner, placement_check, "Segment plan to")
Rel(placement_check, renderer, "Approved plan to")
Rel(renderer, ffmpeg_ffprobe, "Runs", "child process")
Rel(renderer, work_directory, "Writes final-narrated-tight.mp4")

LAYOUT_WITH_LEGEND()
@enduml
