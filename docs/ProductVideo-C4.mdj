        {
          "_type": "UMLPackage",
          "_id": "c4-pkg-3281",
          "_parent": {
            "$ref": "c4-model-0002"
          },
          "name": "3.8c — Components · Diagram Renderer",
          "documentation": "Inside diagram.mjs. Everything is drawn with canvas, so a diagram renders the same in a build, a test or an agent run, with no browser.",
          "ownedElements": [
            {
              "_type": "UMLClass",
              "_id": "c4-el-3282",
              "_parent": {
                "$ref": "c4-pkg-3281"
              },
              "name": "Spec checker",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: diagram.mjs normaliseDiagram\n\nDefaults the spec and refuses what would draw wrong: duplicate ids, arrows to missing nodes, unknown icons, shapes or layouts. Counts the build-up steps."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3283",
              "_parent": {
                "$ref": "c4-pkg-3281"
              },
              "name": "Layout",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: diagram.mjs ranks + place\n\nRanks nodes along the flow (longest path, cycles ignored), sizes each rank by its widest box and each gap by the widest arrow label crossing it, and centres the flow; grid and manual layouts too."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3284",
              "_parent": {
                "$ref": "c4-pkg-3281"
              },
              "name": "Icon set",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: vendor/lucide (ISC)\n\n1,854 Lucide icons as SVG paths on a 24-unit grid, drawn as strokes with Path2D; old names resolve through aliases."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3285",
              "_parent": {
                "$ref": "c4-pkg-3281"
              },
              "name": "Painter",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: @napi-rs/canvas\n\nDraws the heading, groups, arrows with label pills, boxes with icons and bar charts, up to a step, in the colours and fonts of the style guide."
            },
