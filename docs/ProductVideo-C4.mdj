        {
          "_type": "UMLPackage",
          "_id": "c4-pkg-3700",
          "_parent": {
            "$ref": "c4-model-0002"
          },
          "name": "3.12 — Components · Publisher",
          "documentation": "Inside publish.mjs. The last step of a video, and the only one that sends it anywhere: gated on the video state and on the explicit approval of the user.",
          "ownedElements": [
            {
              "_type": "UMLClass",
              "_id": "c4-el-3701",
              "_parent": {
                "$ref": "c4-pkg-3700"
              },
              "name": "Publish plan",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: check\n\nThe file, its destination (PUBLISH_DEST_{APP} and its kind), the ticket from the manifest, and every reason it may not be published yet: state not done, file missing, destination or Google credentials not set."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3702",
              "_parent": {
                "$ref": "c4-pkg-3700"
              },
              "name": "Google sign-in",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: auth · OAuth loopback + PKCE\n\nOne-time: the user signs in in the browser, Google redirects to a 127.0.0.1 port, and the refresh token is written into .env, never printed."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3703",
              "_parent": {
                "$ref": "c4-pkg-3700"
              },
              "name": "Approval gate",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: upload --approved\n\nRefuses unless the video state is done (or already published) and --approved is given, which Claude passes only after the user says to publish."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3704",
              "_parent": {
                "$ref": "c4-pkg-3700"
              },
              "name": "Drive uploader",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: resumable upload · 8 MB chunks\n\nUploads into the destination folder as the user, or adds a new revision of the file published before so its link stays the same."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3705",
              "_parent": {
                "$ref": "c4-pkg-3700"
              },
              "name": "Publication record",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: memory.mjs recordVideo · video sync\n\nRecords the link, file id and destination in the video state (status published), posts it to the video thread and states it as facts in the app graph. jira records the comment Claude posted."
            },
