        {
          "_type": "UMLPackage",
          "_id": "c4-pkg-3392",
          "_parent": {
            "$ref": "c4-model-0002"
          },
          "name": "3.10 — Components · Music Mixer",
          "documentation": "Inside music.mjs. The synthesis is a vendored audio engine, kept with its MIT licence; the stage adds measurement and the mix onto a finished video.",
          "ownedElements": [
            {
              "_type": "UMLClass",
              "_id": "c4-el-3393",
              "_parent": {
                "$ref": "c4-pkg-3392"
              },
              "name": "Spec checker",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: music.mjs normaliseMusic\n\nA style or a file, volume 0-1, how far under the voice; refuses an unknown style or both at once."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3394",
              "_parent": {
                "$ref": "c4-pkg-3392"
              },
              "name": "Voice meter",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: ffmpeg silencedetect + ebur128\n\nFinds the speech spans in the own audio of the video (narration and voiced cards) and its loudness."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3395",
              "_parent": {
                "$ref": "c4-pkg-3392"
              },
              "name": "Synthesis engine",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: vendor/music-engine (MIT)\n\nRenders the bed in one of five styles, deterministic from a seed, or levels a file to the same loudness; ducks it 8 dB under the speech spans."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3396",
              "_parent": {
                "$ref": "c4-pkg-3392"
              },
              "name": "Mixer",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: ffmpeg amix + alimiter\n\nSets the bed a fixed distance under the measured voice, mixes it in, limits peaks and copies the video."
            },
