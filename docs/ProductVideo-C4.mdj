        {
          "_type": "UMLPackage",
          "_id": "c4-pkg-3118",
          "_parent": {
            "$ref": "c4-model-0002"
          },
          "name": "3.8b — Components · Still Inserter",
          "documentation": "Inside inserts.mjs. Placement comes from the section cards, never from hand-typed times, so a re-render that moves a card moves the stills with it.",
          "ownedElements": [
            {
              "_type": "UMLClass",
              "_id": "c4-el-3119",
              "_parent": {
                "$ref": "c4-pkg-3118"
              },
              "name": "Scheduler",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: inserts.mjs insertSchedule\n\nFrom cards/sections.json: the end of the named card to the start of the next, or to the outro. Splits that span between the images by share. Refuses an unknown section or a span too short to fade in and out."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3120",
              "_parent": {
                "$ref": "c4-pkg-3118"
              },
              "name": "Window finder",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: inserts.mjs findWindowRect\n\nReads one frame of the carded video and finds the app window as everything that is not the brand background, so padding, corners and shadow match whatever compose drew."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3121",
              "_parent": {
                "$ref": "c4-pkg-3118"
              },
              "name": "Plate painter",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: @napi-rs/canvas\n\nFits the image inside the window, letterboxed with its own edge colour, clipped to rounded corners, with the red frame in the highlight colour when the spec gives one."
            },
            {
              "_type": "UMLClass",
              "_id": "c4-el-3122",
              "_parent": {
                "$ref": "c4-pkg-3118"
              },
              "name": "Overlay",
              "stereotype": {
                "$ref": "c4-st-0009"
              },
              "documentation": "Technology: ffmpeg overlay + alpha fade\n\nLays a still of the card under its own dissolve, overlays each full-frame plate for its slot (dissolving in over the card, over the plate before, and out over the next card), and copies the audio."
            },
