@startuml c4-l3-publisher
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Publisher (publish.mjs)
caption Level 3, container "Publisher".

Person(demo_author, "Demo author", "Developer or PM. Writes the flow in plain English or as a .demo script, points it at a deployment with a target, and builds the video: one stage at a time from a shell, or every part of a video wit...")
ContainerDb(work_directory, "Work directory", "out/ · out/{video}/{part}/", "One folder per take: out/ by default, or out/{video}/{part}/ when the build orchestrator sets DEMO_OUT, so takes never overwrite each other.")
Container(memory, "Memory", "memory.mjs · Node.js + @getzep/zep-cloud", "Bookkeeping for project memory: finds the source of each app from .env, diffs a remote listing against the sync lock next to the catalog (files older than the catalog are its baseline), merges new...")
System_Ext(video_destination, "Video destination", "Google Drive API v3 · HTTPS. Where finished videos are published: a Google Drive folder per app, located by PUBLISH_DEST_{APP} in .env.")
System_Ext(jira, "Jira", "Atlassian MCP. The ticket each video is for (the manifest names it).")

Container_Boundary(publisher_2, "Publisher") {
  Component(publish_plan, "Publish plan", "check", "The file, its destination (PUBLISH_DEST_{APP} and its kind), the ticket from the manifest, and every reason it may not be published yet: state not done, file missing, destination or Google credenti...")
  Component(google_sign_in, "Google sign-in", "auth · OAuth loopback + PKCE", "One-time: the user signs in in the browser, Google redirects to a 127.0.0.1 port, and the refresh token is written into .env, never printed.")
  Component(approval_gate, "Approval gate", "upload --approved", "Refuses unless the video state is done (or already published) and --approved is given, which Claude passes only after the user says to publish.")
  Component(drive_uploader, "Drive uploader", "resumable upload · 8 MB chunks", "Uploads into the destination folder as the user, or adds a new revision of the file published before so its link stays the same.")
  Component(publication_record, "Publication record", "memory.mjs recordVideo · video sync", "Records the link, file id and destination in the video state (status published), posts it to the video thread and states it as facts in the app graph. jira records the comment Claude posted.")
}

Rel(demo_author, google_sign_in, "Signs in once", "CLI")
Rel(demo_author, approval_gate, "Approves, then Claude runs upload", "CLI")
Rel(approval_gate, publish_plan, "Checks")
Rel(publish_plan, memory, "Reads the video state via", "import")
Rel(publish_plan, work_directory, "Finds the MP4 in")
Rel(approval_gate, drive_uploader, "Approved to")
Rel(google_sign_in, drive_uploader, "Refresh token for")
Rel(drive_uploader, video_destination, "Uploads to", "HTTPS")
Rel(drive_uploader, publication_record, "The link to")
Rel(publication_record, memory, "Records and syncs via", "import + child process")
Rel(demo_author, jira, "Posts the link on the ticket (through Claude)", "MCP")

LAYOUT_WITH_LEGEND()
@enduml
