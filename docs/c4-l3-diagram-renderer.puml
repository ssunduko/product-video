@startuml c4-l3-diagram-renderer
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Diagram Renderer (diagram.mjs)
caption Level 3, container "8c · Diagram Renderer".

ContainerDb(video_manifests, "Video manifests", "videos/*.json", "One per finished video: its parts in recording order with what must be true before each take, the settings every stage runs with, and how the parts join.")
ContainerDb(brand_assets, "Brand assets", "brand/", "StyleGuide.txt (colour and type, the source of truth), the logo, and the font files.")
ContainerDb(work_directory, "Work directory", "out/ · out/{video}/{part}/", "One folder per take: out/ by default, or out/{video}/{part}/ when the build orchestrator sets DEMO_OUT, so takes never overwrite each other.")

Container_Boundary(c_diagram_renderer_2, "8c · Diagram Renderer") {
  Component(spec_checker, "Spec checker", "diagram.mjs normaliseDiagram", "Defaults the spec and refuses what would draw wrong: duplicate ids, arrows to missing nodes, unknown icons, shapes or layouts.")
  Component(layout, "Layout", "diagram.mjs ranks + place", "Ranks nodes along the flow (longest path, cycles ignored), sizes each rank by its widest box and each gap by the widest arrow label crossing it, and centres the flow; grid and manual layouts too.")
  Component(icon_set, "Icon set", "vendor/lucide (ISC)", "1,854 Lucide icons as SVG paths on a 24-unit grid, drawn as strokes with Path2D; old names resolve through aliases.")
  Component(painter, "Painter", "@napi-rs/canvas", "Draws the heading, groups, arrows with label pills, boxes with icons and bar charts, up to a step, in the colours and fonts of the style guide.")
}

Rel(video_manifests, spec_checker, "Inserts name a diagram spec")
Rel(spec_checker, icon_set, "Checks icon names against")
Rel(spec_checker, layout, "Nodes and edges to")
Rel(layout, painter, "Positions to")
Rel(icon_set, painter, "Icon paths to")
Rel(brand_assets, painter, "Colours and fonts to")
Rel(painter, work_directory, "Writes a PNG per step")

LAYOUT_WITH_LEGEND()
@enduml
