@startuml c4-l3-narrator
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Narrator (narrate.mjs)
caption Level 3, container "6 · Narrator".

ContainerDb(tts_clip_cache, "TTS clip cache", "out/tts/ · mp3", "One mp3 per line, keyed by provider+voice+text, plus the derived .lead.mp3 with the opening breath trimmed.")
System_Ext(text_to_speech_api, "Text-to-speech API", "ElevenLabs or OpenAI. Chosen by DEMO_TTS, or by whichever key is set.")
ContainerDb(work_directory, "Work directory", "out/ · out/{video}/{part}/", "One folder per take: out/ by default, or out/{video}/{part}/ when the build orchestrator sets DEMO_OUT, so takes never overwrite each other.")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")

Container_Boundary(narrator_2, "6 · Narrator") {
  Component(cue_file_resolver, "Cue file resolver", "narrate.mjs", "Reads videoPath out of {take}.recordly to find the cue file belonging to the take that was actually composed, falling back to newest-mtime.")
  Component(tts_gateway, "TTS gateway", "tts.mjs · shared", "Shared with cards.mjs, which is why both stages voice a script identically.")
  Component(breath_trimmer, "Breath trimmer", "tts.mjs · ffmpeg astats", "TTS does not start on the word; it starts on 100-160ms at -50 to -85 dB. Cued at the file start that is heard as the line fading up, and normalising a breath just gives a louder breath.")
  Component(loudness_meter, "Loudness meter", "ffmpeg ebur128", "Integrated LUFS per clip.")
  Component(clip_leveller, "Clip leveller", "ffmpeg volume", "Static gain to NARRATION_PREMIX_LUFS (-20), capped at ±6 dB, applied per clip before the mix.")
  Component(overlap_checker, "Overlap checker", "narrate.mjs", "Warns when one line runs into the next rather than letting two clips talk over each other.")
  Component(tail_guard, "Tail guard", "ffmpeg tpad", "A screencast stops emitting frames when the page stops changing, so a closing line can outlast the video; the last frame is held to cover it.")
  Component(mix_graph_builder, "Mix graph builder", "ffmpeg filter_complex", "Per clip: volume, then adelay to the cue time.")
  Component(muxer, "Muxer", "ffmpeg", "Copies the video stream untouched unless the tail guard needed extra room, so the stage costs seconds rather than a re-render.")
}

Rel(cue_file_resolver, work_directory, "Reads {take}.recordly + the cue file")
Rel(cue_file_resolver, tts_gateway, "One line at a time to")
Rel(tts_gateway, tts_clip_cache, "Hits before spending")
Rel(tts_gateway, text_to_speech_api, "Renders a miss", "HTTPS")
Rel(tts_gateway, breath_trimmer, "Derives a trimmed clip via")
Rel(breath_trimmer, tts_clip_cache, "Writes .lead.mp3 beside the original")
Rel(breath_trimmer, loudness_meter, "Trimmed clip to")
Rel(loudness_meter, clip_leveller, "Integrated LUFS to")
Rel(cue_file_resolver, overlap_checker, "Cue times + clip lengths to")
Rel(cue_file_resolver, tail_guard, "Last cue end vs video length to")
Rel(clip_leveller, mix_graph_builder, "Per-clip gain to")
Rel(tail_guard, mix_graph_builder, "Pad duration to")
Rel(mix_graph_builder, muxer, "Filter graph to")
Rel(muxer, ffmpeg_ffprobe, "Runs", "child process")
Rel(muxer, work_directory, "Writes final-narrated.mp4")

LAYOUT_WITH_LEGEND()
@enduml
