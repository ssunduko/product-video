@startuml c4-l3-test-suites
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Test Suites (pipeline/test)
caption Level 3, container "Test Suites".

System_Ext(github_actions, "GitHub Actions", "GitHub-hosted runners. Runs the unit and integration tests (tests.yml) on every pull request, push to main and merge group, and the docs check (docs.yml).")
Person(demo_author, "Demo author", "Developer or PM. Writes the flow in plain English or as a .demo script, points it at a deployment with a target, and builds the video: one stage at a time from a shell, or every part of a video wit...")
Container(author, "0 · Author", "author.mjs · Node.js", "Turns an observed walk of the app into the DSL. Reads a trace — the selectors found and the wait times measured — and emits the .demo and its selector sidecar together.")
Container(script_compiler, "1 · Script Compiler", "script.mjs · Node.js", "Compiles a .demo flow into a normal, inspectable scenario module.")
Container(card_renderer, "8 · Card Renderer", "cards.mjs · Node.js + canvas + ffmpeg", "Renders branded intro/outro title cards, voices them with the same provider, and dissolves them on with the concat filter rather than the demuxer.")
Container(narrator, "6 · Narrator", "narrate.mjs · Node.js + ffmpeg", "Voices the say-cues, trims the breath off each clip, levels every clip to a common loudness, and mixes them onto the video.")
ContainerDb(observed_traces, "Observed traces", "scenarios/*.trace.json", "What the app actually did on a real walk: the selector each step needs, the evidence for it, and how long every wait took.")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")

Container_Boundary(test_suites_2, "Test Suites") {
  Component(unit_suite, "Unit suite", "pipeline/test/unit · node:test", "Pure functions, no ffmpeg and no network: voice and avatar selection in tts.mjs (on, off, typos, precedence, missing settings, with fetch stubbed), the .demo language in script.mjs, trace authoring...")
  Component(integration_suite, "Integration suite", "pipeline/test/integration · node:test", "The real CLIs end to end. author.mjs to script.mjs to loading the scenario, in a temp folder, plus author.mjs --check on the committed traces; cards.mjs with the avatar on, off, with a clip missing...")
  Component(integration_helpers, "Integration helpers", "test/integration/helpers.mjs", "Runs a stage as its CLI with the voice and avatar variables cleared, makes solid-colour stand-in clips with a tone, and reads durations, audio streams and single pixels back out of a video.")
  Component(tests_workflow, "Tests workflow", ".github/workflows/tests.yml", "Two jobs, unit and integration, on every pull request, push to main and merge group.")
}

Rel(github_actions, tests_workflow, "Triggers on PR, push to main, merge group")
Rel(tests_workflow, unit_suite, "npm run test:unit")
Rel(tests_workflow, integration_suite, "npm run test:integration")
Rel(demo_author, unit_suite, "npm run test", "CLI")
Rel(demo_author, integration_suite, "npm run test", "CLI")
Rel(unit_suite, author, "Imports budget and demoFromTrace from", "import")
Rel(unit_suite, script_compiler, "Imports the parser and compiler from", "import")
Rel(unit_suite, narrator, "Imports the shared voice choice (tts.mjs) of", "import")
Rel(unit_suite, observed_traces, "Reads the example trace")
Rel(integration_suite, integration_helpers, "Uses")
Rel(integration_helpers, author, "Runs author.mjs", "child process")
Rel(integration_helpers, script_compiler, "Runs script.mjs", "child process")
Rel(integration_helpers, card_renderer, "Runs cards.mjs, avatar on and off", "child process")
Rel(integration_helpers, ffmpeg_ffprobe, "Makes stand-in clips; reads pixels", "child process")
Rel(integration_suite, observed_traces, "Copies the example trace to a temp folder")

LAYOUT_WITH_LEGEND()
@enduml
