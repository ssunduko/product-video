@startuml c4-l3-memory
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Memory (memory.mjs)
caption Level 3, container "Memory".

System_Ext(memory_agent, "memory agent", "Claude Code subagent. Runs at session start when a feature source is stale: lists each online source of an app with its MCP tool, reads what changed, merges its features into the catalog and pushes them to Zep.")
ContainerDb(project_memory, "Project memory", "memory/ · committed", "rules.md (imported by CLAUDE.md), features/{app}/data/features.json (the feature catalog, the initial set), features/{app}/*.md (one page per filmed feature, naming its videos), sources.json (gener...")
ContainerDb(observed_traces, "Observed traces", "scenarios/*.trace.json", "What the app actually did on a real walk: the selector each step needs, the evidence for it, and how long every wait took.")
ContainerDb(video_manifests, "Video manifests", "videos/*.json", "One per finished video: its parts in recording order with what must be true before each take, the settings every stage runs with, and how the parts join.")
Container(build_orchestrator, "Build Orchestrator", "build.mjs · Node.js + ffmpeg", "Builds a whole video from its manifest: records and renders every part into its own folder, gates each on the quality gate, trims the silence at each join by measurement, crossfades the parts and g...")
System_Ext(zep_cloud, "Zep Cloud", "@getzep/zep-cloud · HTTPS. Searchable memory: one graph per app for feature pages, traces and manifests, one for rules and pipeline notes, and a thread per working session.")

Container_Boundary(memory_2, "Memory") {
  Component(source_resolver, "Source resolver", "sources.json + .env · source", "Finds the apps (one folder per app under memory/features), the catalog of each, and its online source from FEATURE_SOURCE_{APP} in .env; recognises the kind of source and names the tools to list an...")
  Component(change_detector, "Change detector", "diff · baseline", "Compares a source listing with the sync lock: new, changed, removed, unchanged.")
  Component(catalog_merger, "Catalog merger", "upsert", "Merges the features the agent found into data/features.json: matched by name, a new one gets the next feature id; totals and the updated date follow.")
  Component(sync_lock, "Sync lock", "mark · synced", "data/sources.lock.json next to each catalog: every source file seen, its kind and the features it fed, and when the app was last synced.")
  Component(staleness_check, "Staleness check", "staleSources() · MEMORY_MAX_AGE_H", "Apps whose source was last synced longer ago than the limit.")
  Component(session_hook, "Session hook", "hook · SessionStart", "Runs when a Claude Code session starts: attributes the session to its user, opens its Zep thread, and asks Claude to launch the memory agent when a source is stale.")
  Component(session_attribution, "Session attribution", "MEMORY_USER · Zep users and threads", "One Zep user per person (MEMORY_USER, else git user.email) and one thread per Claude session; zep session adds notes to it.")
  Component(zep_publisher, "Zep publisher", "zep push", "Turns catalogs (one document per feature), video pages, rules, pipeline lessons, traces and manifests into Zep documents in the graph of their app.")
  Component(zep_search, "Zep search", "zep search", "Facts from the graph of one app, or of all of them.")
}

Rel(memory_agent, source_resolver, "Asks where the source is", "CLI")
Rel(memory_agent, change_detector, "Hands the source listing to", "CLI")
Rel(memory_agent, catalog_merger, "Hands the features it read to", "CLI")
Rel(memory_agent, zep_publisher, "Runs", "CLI")
Rel(source_resolver, project_memory, "Reads sources.json and the catalogs")
Rel(change_detector, sync_lock, "Compares with")
Rel(catalog_merger, project_memory, "Writes data/features.json")
Rel(catalog_merger, sync_lock, "Then records the file in")
Rel(sync_lock, project_memory, "Writes data/sources.lock.json")
Rel(staleness_check, sync_lock, "Reads the last sync from")
Rel(build_orchestrator, staleness_check, "Warns on stale sources", "import")
Rel(session_hook, staleness_check, "Checks")
Rel(session_hook, session_attribution, "Opens the session thread via")
Rel(session_attribution, zep_cloud, "Users, threads, messages", "HTTPS")
Rel(zep_publisher, project_memory, "Reads catalogs, pages, rules")
Rel(zep_publisher, observed_traces, "Reads")
Rel(zep_publisher, video_manifests, "Reads")
Rel(zep_publisher, zep_cloud, "Adds and deletes episodes", "HTTPS")
Rel(zep_search, zep_cloud, "Searches facts", "HTTPS")

LAYOUT_WITH_LEGEND()
@enduml
