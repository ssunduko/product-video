@startuml c4-l3-music-mixer
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Music Mixer (music.mjs)
caption Level 3, container "10 · Music Mixer".

ContainerDb(video_manifests, "Video manifests", "videos/*.json", "One per finished video: its parts in recording order with what must be true before each take, the settings every stage runs with, and how the parts join.")
ContainerDb(work_directory, "Work directory", "out/ · out/{video}/{part}/", "One folder per take: out/ by default, or out/{video}/{part}/ when the build orchestrator sets DEMO_OUT, so takes never overwrite each other.")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")

Container_Boundary(music_mixer_2, "10 · Music Mixer") {
  Component(spec_checker_2, "Spec checker", "music.mjs normaliseMusic", "A style or a file, volume 0-1, how far under the voice; refuses an unknown style or both at once.")
  Component(voice_meter, "Voice meter", "ffmpeg silencedetect + ebur128", "Finds the speech spans in the own audio of the video (narration and voiced cards) and its loudness.")
  Component(synthesis_engine, "Synthesis engine", "vendor/music-engine (MIT)", "Renders the bed in one of five styles, deterministic from a seed, or levels a file to the same loudness; ducks it 8 dB under the speech spans.")
  Component(mixer, "Mixer", "ffmpeg amix + alimiter", "Sets the bed a fixed distance under the measured voice, mixes it in, limits peaks and copies the video.")
}

Rel(video_manifests, spec_checker_2, "The music block to")
Rel(work_directory, voice_meter, "Reads the joined MP4")
Rel(voice_meter, ffmpeg_ffprobe, "Runs", "child process")
Rel(spec_checker_2, synthesis_engine, "Style or file to")
Rel(voice_meter, synthesis_engine, "Speech spans to")
Rel(synthesis_engine, mixer, "The bed (WAV) to")
Rel(voice_meter, mixer, "Voice loudness to")
Rel(mixer, ffmpeg_ffprobe, "Runs", "child process")
Rel(mixer, work_directory, "Writes the MP4 with music")

LAYOUT_WITH_LEGEND()
@enduml
