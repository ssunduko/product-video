@startuml c4-l3-still-inserter
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Still Inserter (inserts.mjs)
caption Level 3, container "8b · Still Inserter".

ContainerDb(video_manifests, "Video manifests", "videos/*.json", "One per finished video: its parts in recording order with what must be true before each take, the settings every stage runs with, and how the parts join.")
ContainerDb(work_directory, "Work directory", "out/ · out/{video}/{part}/", "One folder per take: out/ by default, or out/{video}/{part}/ when the build orchestrator sets DEMO_OUT, so takes never overwrite each other.")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")

Container_Boundary(b_still_inserter_2, "8b · Still Inserter") {
  Component(scheduler, "Scheduler", "inserts.mjs insertSchedule", "From cards/sections.json: the end of the named card to the start of the next, or to the outro.")
  Component(window_finder, "Window finder", "inserts.mjs findWindowRect", "Reads one frame of the carded video and finds the app window as everything that is not the brand background, so padding, corners and shadow match whatever compose drew.")
  Component(plate_painter, "Plate painter", "@napi-rs/canvas", "Fits the image inside the window, letterboxed with its own edge colour, clipped to rounded corners, with the red frame in the highlight colour when the spec gives one.")
  Component(overlay, "Overlay", "ffmpeg overlay + alpha fade", "Lays a still of the card under its own dissolve, overlays each full-frame plate for its slot (dissolving in over the card, over the plate before, and out over the next card), and copies the audio.")
}

Rel(video_manifests, scheduler, "The inserts of the part to")
Rel(work_directory, scheduler, "Reads cards/sections.json")
Rel(work_directory, window_finder, "Reads a frame of the carded MP4")
Rel(window_finder, plate_painter, "Window rect to")
Rel(scheduler, overlay, "Slots to")
Rel(plate_painter, overlay, "Plates to")
Rel(overlay, ffmpeg_ffprobe, "Runs", "child process")
Rel(overlay, work_directory, "Writes the inserted MP4")

LAYOUT_WITH_LEGEND()
@enduml
