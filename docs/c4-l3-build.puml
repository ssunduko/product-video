@startuml c4-l3-build
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Build Orchestrator (build.mjs)
caption Level 3, container "Build Orchestrator".

Person(demo_author, "Demo author", "Developer or PM. Writes the flow in plain English or as a .demo script, points it at a deployment with a target, and builds the video: one stage at a time from a shell, or every part of a video wit...")
ContainerDb(video_manifests, "Video manifests", "videos/*.json", "One per finished video: its parts in recording order with what must be true before each take, the settings every stage runs with, and how the parts join.")
ContainerDb(work_directory, "Work directory", "out/ · out/{video}/{part}/", "One folder per take: out/ by default, or out/{video}/{part}/ when the build orchestrator sets DEMO_OUT, so takes never overwrite each other.")
Container(driver, "2 · Driver", "driver.mjs · Node.js + puppeteer-core", "Launches Chrome, signs in if the target says to, runs the flow, and records a screencast plus cursor, click and narration-cue telemetry, plus the real start and end of every wait.")
Container(quality_gate, "9 · Quality Gate", "qa.mjs · Node.js + ffmpeg", "Measures what a viewer notices and a stage only warns about: two narration lines at once, a line off its cue, dead air, a frozen or loading screen, black frames, mismatched streams, loudness, and a...")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")

Container_Boundary(build_orchestrator_2, "Build Orchestrator") {
  Component(manifest_reader, "Manifest reader", "videos/*.json", "The parts in recording order, the env every stage gets, the crossfade and the silence to keep either side of a join.")
  Component(part_folders, "Part folders", "paths.mjs · DEMO_OUT", "Each part builds in out/{video}/{part}/, so no take overwrites another's fixed-name stage files.")
  Component(part_runner, "Part runner", "child processes", "driver, assemble, project, compose, narrate, tighten and cards, in order, each with the part's folder and the manifest env.")
  Component(part_gate, "Part gate", "qa.mjs", "Runs the quality gate on each part and stops the build on a failure, naming the part to fix and how to rerun it.")
  Component(join_planner, "Join planner", "ffmpeg silencedetect", "Measures each part's first and last word and keeps leadS before and tailS after them, so joins are trimmed by measurement rather than by hand-picked times.")
  Component(joiner_2, "Joiner", "ffmpeg xfade + acrossfade", "Chains a crossfade between every pair of parts, video and audio together.")
  Component(joined_gate, "Joined gate", "qa.mjs --cues none", "Whole-video checks on the result, with the first part intro card and the last part outro card left out.")
  Component(build_report, "Build report", "build.json", "The trims and every verdict, beside the parts.")
}

Rel(demo_author, manifest_reader, "Runs", "CLI")
Rel(manifest_reader, video_manifests, "Reads")
Rel(manifest_reader, part_folders, "Parts to")
Rel(part_folders, part_runner, "Each part with its folder to")
Rel(part_runner, driver, "Runs driver.mjs, then every later stage", "child process")
Rel(part_runner, work_directory, "Each stage writes the part's files in")
Rel(part_runner, part_gate, "Then")
Rel(part_gate, quality_gate, "Runs", "child process")
Rel(part_gate, join_planner, "Passed parts to")
Rel(join_planner, ffmpeg_ffprobe, "Measures speech via", "child process")
Rel(join_planner, joiner_2, "Trims to")
Rel(joiner_2, ffmpeg_ffprobe, "Runs", "child process")
Rel(joiner_2, work_directory, "Writes the joined MP4")
Rel(joiner_2, joined_gate, "The joined video to")
Rel(joined_gate, quality_gate, "Runs", "child process")
Rel(joined_gate, build_report, "Verdict to")
Rel(build_report, work_directory, "Writes build.json")

LAYOUT_WITH_LEGEND()
@enduml
