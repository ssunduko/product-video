@startuml c4-l3-card-renderer
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Card Renderer (cards.mjs)
caption Level 3, container "8 · Card Renderer".

ContainerDb(flow_definitions, "Flow definitions", "input/ + scenarios/ authored, scripts/ generated", "What happens on screen and what is said over it.")
ContainerDb(brand_assets, "Brand assets", "brand/", "StyleGuide.txt (colour and type, the source of truth), the logo, and the font files.")
ContainerDb(tts_clip_cache, "TTS clip cache", "out/tts/ · mp3", "One mp3 per line, keyed by provider+voice+text, plus the derived .lead.mp3 with the opening breath trimmed.")
System_Ext(text_to_speech_api, "Text-to-speech API", "ElevenLabs or OpenAI. Chosen by DEMO_TTS, or by whichever key is set.")
ContainerDb(work_directory, "Work directory", "out/ · out/{video}/{part}/", "One folder per take: out/ by default, or out/{video}/{part}/ when the build orchestrator sets DEMO_OUT, so takes never overwrite each other.")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")

Container_Boundary(card_renderer_2, "8 · Card Renderer") {
  Component(copy_parser, "Copy parser", "cards.mjs + script.mjs", "The intro and outro header directives, split on a pipe into headline and subhead.")
  Component(style_guide_reader, "Style guide reader", "brand.mjs · shared", "Colour and type from brand/StyleGuide.txt, shared with the compositor so the style-guide hex cannot end up in one stage and not the other.")
  Component(font_loader, "Font loader", "cards.mjs + @napi-rs/canvas", "Registers every font file in the brand directory.")
  Component(card_painter, "Card painter", "@napi-rs/canvas", "The brand hex flat across the top 55% and deepening below, so sampling the field returns the style-guide colour rather than a near-black navy.")
  Component(tts_gateway_2, "TTS gateway", "tts.mjs · shared", "The same provider, cache and breath trim the narrator uses.")
  Component(clip_builder, "Clip builder", "ffmpeg", "Still plus voice, with a lead-in long enough to clear the dissolve.")
  Component(joiner, "Joiner", "ffmpeg xfade + acrossfade", "Normalises frame rate, pixel format and timebase on every input first, then dissolves card into demo.")
}

Rel(flow_definitions, copy_parser, "intro and outro headers to")
Rel(style_guide_reader, brand_assets, "Reads colour and type")
Rel(font_loader, brand_assets, "Registers the font files")
Rel(copy_parser, card_painter, "Headline and subhead to")
Rel(style_guide_reader, card_painter, "Palette to")
Rel(font_loader, card_painter, "Resolved typefaces to")
Rel(card_painter, brand_assets, "Reads the logo")
Rel(copy_parser, tts_gateway_2, "Spoken line to")
Rel(tts_gateway_2, tts_clip_cache, "Hits before spending")
Rel(tts_gateway_2, text_to_speech_api, "Renders a miss", "HTTPS")
Rel(card_painter, clip_builder, "Card PNG to")
Rel(tts_gateway_2, clip_builder, "Card voice to")
Rel(clip_builder, joiner, "Card clips to")
Rel(work_directory, joiner, "The tightened video to")
Rel(joiner, ffmpeg_ffprobe, "Runs", "child process")
Rel(joiner, work_directory, "Writes the carded MP4")

LAYOUT_WITH_LEGEND()
@enduml
