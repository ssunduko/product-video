@startuml c4-l3-assembler
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Assembler (assemble.mjs)
caption Level 3, container "3 · Assembler".

ContainerDb(work_directory, "Work directory", "out/", "frames/, frames.json, actions.json, the per-take cursor.json and narration.json, demo.recordly, and the MP4 at each stage: raw, cut, final, final-narrated, -tight, -carded.")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")

Container_Boundary(assembler_2, "3 · Assembler") {
  Component(cut_and_speed_config, "Cut and speed config", "CUTS_MS, SPEEDS_MS · env", "Two ways to shorten a take: a cut drops the frames, a speed keeps them and plays them fast.")
  Component(time_warp, "Time warp", "assemble.mjs", "The single function that moves a timestamp.")
  Component(frame_selector, "Frame selector", "assemble.mjs", "Drops frames inside a cut and rewrites the timestamp of the rest.")
  Component(gap_reporter, "Gap reporter", "assemble.mjs", "Prints the five largest inter-frame gaps over a second.")
  Component(concat_list_writer, "Concat list writer", "ffmpeg concat demuxer", "A file and duration pair per frame, with the last frame repeated so its duration is honoured.")
  Component(encoder, "Encoder", "ffmpeg libx264", "Scales to 1920x1080 with lanczos at 60fps, CRF 18.")
  Component(telemetry_mapper, "Telemetry mapper", "assemble.mjs", "Normalises pointer samples to 0..1 of the viewport, drops what fell inside a cut, and warps the rest.")
  Component(cue_mapper, "Cue mapper", "assemble.mjs", "The identical filter and warp for narration cues, and it reports how many were dropped inside cuts.")
}

Rel(cut_and_speed_config, time_warp, "Validated ranges to")
Rel(work_directory, frame_selector, "frames.json and actions.json to")
Rel(frame_selector, time_warp, "Every frame timestamp through")
Rel(telemetry_mapper, time_warp, "Every pointer sample through")
Rel(cue_mapper, time_warp, "Every cue time through")
Rel(frame_selector, gap_reporter, "Surviving frames to")
Rel(frame_selector, concat_list_writer, "Surviving frames to")
Rel(concat_list_writer, encoder, "list.txt to")
Rel(encoder, ffmpeg_ffprobe, "Runs", "child process")
Rel(encoder, work_directory, "Writes raw.mp4 or cut.mp4")
Rel(telemetry_mapper, work_directory, "Writes cursor.json")
Rel(cue_mapper, work_directory, "Writes narration.json")

LAYOUT_WITH_LEGEND()
@enduml
