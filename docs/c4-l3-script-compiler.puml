@startuml c4-l3-script-compiler
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Script Compiler (script.mjs)
caption Level 3, container "1 · Script Compiler".

Person(demo_author, "Demo author", "Developer or PM. Writes the flow in plain English or as a .demo script, points it at a deployment with a target, and builds the video: one stage at a time from a shell, or every part of a video wit...")
ContainerDb(flow_definitions, "Flow definitions", "input/ + scenarios/ authored, scripts/ generated", "What happens on screen and what is said over it.")
ContainerDb(selector_resolutions, "Selector resolutions", "scripts/*.selectors.json", "What each ask description resolved to against the live DOM, plus the evidence for it.")
System_Ext(claude_in_chrome_extension, "Claude in Chrome extension", "Browser extension. Drives the user own Chrome, with their own session, so there is no SSO ritual and no email code to fill.")

Container_Boundary(script_compiler_2, "1 · Script Compiler") {
  Component(lexer, "Lexer", "script.mjs", "One command per line.")
  Component(selector_spec_parser, "Selector spec parser", "script.mjs", "Turns the button, text and css forms of a selector line into the driver spec strings.")
  Component(sel_registry, "SEL registry", "script.mjs", "Names in the selectors block become slugged keys on the exported SEL map, deduped so two similar labels cannot quietly collide on one key.")
  Component(header_parser, "Header parser", "script.mjs", "target, app, viewport, match, intro, outro and brand.")
  Component(beat_parser, "Beat parser", "script.mjs", "Beats of wait, click, hover, hold, type, press, scroll, open, login, logout, say and if-appears, each becoming one step in order.")
  Component(ask_resolver, "Ask resolver", "script.mjs · selectors sidecar", "An ask selector parses to a sentinel spec that travels through the registry as an ordinary string, then gets swapped here for what the sidecar resolved it to.")
  Component(code_generator, "Code generator", "script.mjs", "Emits a scenario module: the SEL map, run(d), and the header exports.")
  Component(overwrite_guard, "Overwrite guard", "script.mjs · generated marker", "Refuses to overwrite a scenario it did not generate; a marker in the header is what tells them apart.")
}

Rel(selector_spec_parser, ask_resolver, "ask sentinels to")
Rel(ask_resolver, selector_resolutions, "Reads the resolution for each intent")
Rel(claude_in_chrome_extension, selector_resolutions, "Resolved it against the live app")
Rel(ask_resolver, code_generator, "Concrete selectors to")
Rel(demo_author, lexer, "Runs, or driver.mjs does", "CLI")
Rel(lexer, flow_definitions, "Reads the .demo")
Rel(lexer, header_parser, "Header lines to")
Rel(lexer, selector_spec_parser, "Selector lines to")
Rel(lexer, beat_parser, "Beat lines to")
Rel(selector_spec_parser, sel_registry, "Registers each spec in")
Rel(sel_registry, beat_parser, "Resolves at-name references for")
Rel(header_parser, code_generator, "Header exports to")
Rel(beat_parser, code_generator, "Step list to")
Rel(code_generator, overwrite_guard, "Scenario source to")
Rel(overwrite_guard, flow_definitions, "Writes the scenario")

LAYOUT_WITH_LEGEND()
@enduml
