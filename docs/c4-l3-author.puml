@startuml c4-l3-author
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Author (author.mjs)
caption Level 3, container "0 · Author".

ContainerDb(observed_traces, "Observed traces", "scenarios/*.trace.json", "What the app actually did on a real walk: the selector each step needs, the evidence for it, and how long every wait took.")
ContainerDb(flow_definitions, "Flow definitions", "input/ + scenarios/ authored, scripts/ generated", "What happens on screen and what is said over it.")
ContainerDb(selector_resolutions, "Selector resolutions", "scripts/*.selectors.json", "What each ask description resolved to against the live DOM, plus the evidence for it.")
System_Ext(claude_in_chrome_extension, "Claude in Chrome extension", "Browser extension. Drives the user own Chrome, with their own session, so there is no SSO ritual and no email code to fill.")

Container_Boundary(author_2, "0 · Author") {
  Component(trace_reader, "Trace reader", "author.mjs", "Loads the trace and refuses one without a beats array.")
  Component(speech_rate_model, "Speech-rate model", "author.mjs · CHARS_PER_SEC", "How long a line takes to say, at 12.5 characters per second.")
  Component(narration_budgeter, "Narration budgeter", "author.mjs · budget()", "Fits as many lines as the measured wait allows, spacing them so none overlaps the next, and stops at a ceiling because wall-to-wall talking over a 40s wait reads worse than a visible fast-forward.")
  Component(selector_registry, "Selector registry", "author.mjs · ref()", "Runs once per step that touches an element and feeds both outputs from that one call: the name and intent go to the .demo selectors block, the spec and evidence to the sidecar.")
  Component(step_emitter, "Step emitter", "author.mjs · emitOne()", "One DSL line per trace step: say, hold, wait, type, press, click, hover, park.")
  Component(header_writer, "Header writer", "author.mjs", "Writes the provenance line, any hazards the walk recorded, and the ready-to-paste SPEEDS_MS command.")
  Component(provenance_stamper, "Provenance stamper", "author.mjs", "Takes resolvedBy and the note from the trace instead of stamping them on.")
  Component(writer, "Writer", "author.mjs", "Writes the .demo and derives the sidecar path by swapping the extension — the same rule script.mjs uses to find it, which is why the two must sit together.")
}

Rel(claude_in_chrome_extension, observed_traces, "Observed and measured it")
Rel(trace_reader, observed_traces, "Reads")
Rel(trace_reader, step_emitter, "Beats and steps to")
Rel(trace_reader, header_writer, "Warnings and provenance to")
Rel(trace_reader, provenance_stamper, "resolvedBy and note to")
Rel(speech_rate_model, narration_budgeter, "Line duration to")
Rel(step_emitter, narration_budgeter, "Measured wait and candidate lines to")
Rel(narration_budgeter, header_writer, "SPEEDS_MS ranges to")
Rel(step_emitter, selector_registry, "Each element step to")
Rel(selector_registry, writer, "Intents and specs to")
Rel(step_emitter, writer, "Beat lines to")
Rel(header_writer, writer, "Header to")
Rel(provenance_stamper, writer, "Provenance to")
Rel(writer, flow_definitions, "Writes the .demo")
Rel(writer, selector_resolutions, "Writes the sidecar")

LAYOUT_WITH_LEGEND()
@enduml
