@startuml c4-l3-quality-gate
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Quality Gate (qa.mjs)
caption Level 3, container "9 · Quality Gate".

ContainerDb(work_directory, "Work directory", "out/ · out/{video}/{part}/", "One folder per take: out/ by default, or out/{video}/{part}/ when the build orchestrator sets DEMO_OUT, so takes never overwrite each other.")
ContainerDb(tts_clip_cache, "TTS clip cache", "out/tts/ · mp3", "One mp3 per line, keyed by provider+voice+text, plus the derived .lead.mp3 with the opening breath trimmed.")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")
System_Ext(video_qa_agent, "video-qa agent", "Claude Code subagent. Reviews a finished video: runs the quality gate, then checks every narration line against a still of the screen — is the thing being described on screen while it is said? — and returns PASS or FAIL...")

Container_Boundary(quality_gate_2, "9 · Quality Gate") {
  Component(input_resolver_2, "Input resolver", "qa.mjs", "The deliverable (the newest stage output, or --video), the narrated video, the cue file the narrator used, and the intro and outro card lengths to leave out of the whole-video checks.")
  Component(lineage_check, "Lineage check", "qa.mjs · file times", "Every stage output the deliverable is built from must be newer than the one before it.")
  Component(stream_check, "Stream check", "ffprobe", "Audio and video of the same length and with the same start, or the whole track is shifted.")
  Component(line_checker, "Line checker", "qa.mjs + TTS clip cache", "Overlap: a line still speaking when the next starts — two voices at once.")
  Component(dead_air_detector, "Dead-air detector", "ffmpeg silencedetect", "4s without narration warns and 6s fails, outside the title cards.")
  Component(freeze_classifier, "Freeze classifier", "ffmpeg freezedetect", "A still picture with the voice over most of it is a deliberate hold and only warns; a still picture in silence is a wait and fails at 5s.")
  Component(black_and_loudness, "Black and loudness", "ffmpeg blackdetect + ebur128", "Black frames fail.")
  Component(still_extractor, "Still extractor", "ffmpeg", "One still mid-line for every narration line and one for every flagged range: what the visual review looks at.")
  Component(report_writer, "Report writer", "qa.json", "The verdict, findings ordered fail-first, every line with its timing and still.")
}

Rel(work_directory, input_resolver_2, "Stage outputs and the cue file to")
Rel(input_resolver_2, lineage_check, "The stage chain to")
Rel(input_resolver_2, stream_check, "The deliverable to")
Rel(input_resolver_2, line_checker, "Cues and the narrated video to")
Rel(tts_clip_cache, line_checker, "Line lengths to")
Rel(input_resolver_2, dead_air_detector, "The deliverable and card lengths to")
Rel(input_resolver_2, freeze_classifier, "The deliverable and card lengths to")
Rel(input_resolver_2, black_and_loudness, "The deliverable to")
Rel(lineage_check, report_writer, "Findings to")
Rel(stream_check, report_writer, "Findings to")
Rel(line_checker, report_writer, "Findings to")
Rel(dead_air_detector, report_writer, "Findings to")
Rel(freeze_classifier, report_writer, "Findings to")
Rel(black_and_loudness, report_writer, "Findings to")
Rel(line_checker, still_extractor, "Line times to")
Rel(freeze_classifier, still_extractor, "Flagged ranges to")
Rel(dead_air_detector, still_extractor, "Flagged ranges to")
Rel(stream_check, ffmpeg_ffprobe, "Runs", "child process")
Rel(line_checker, ffmpeg_ffprobe, "Runs", "child process")
Rel(dead_air_detector, ffmpeg_ffprobe, "Runs", "child process")
Rel(freeze_classifier, ffmpeg_ffprobe, "Runs", "child process")
Rel(black_and_loudness, ffmpeg_ffprobe, "Runs", "child process")
Rel(still_extractor, ffmpeg_ffprobe, "Runs", "child process")
Rel(still_extractor, work_directory, "Writes the stills")
Rel(report_writer, work_directory, "Writes qa.json")
Rel(video_qa_agent, report_writer, "Reads the report and stills of")

LAYOUT_WITH_LEGEND()
@enduml
