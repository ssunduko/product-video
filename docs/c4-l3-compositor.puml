@startuml c4-l3-compositor
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Component>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4-L3 — Components · Compositor (compose.mjs)
caption Level 3, container "5 · Compositor".

ContainerDb(work_directory, "Work directory", "out/ · out/{video}/{part}/", "One folder per take: out/ by default, or out/{video}/{part}/ when the build orchestrator sets DEMO_OUT, so takes never overwrite each other.")
ContainerDb(brand_assets, "Brand assets", "brand/", "StyleGuide.txt (colour and type, the source of truth), the logo, and the font files.")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")

Container_Boundary(compositor_2, "5 · Compositor") {
  Component(project_reader, "Project reader", "compose.mjs", "Reads demo.recordly and the take it names, so the composite is always of the video the project was built from.")
  Component(look_resolver, "Look resolver", "compose.mjs + brand.mjs", "padding, radius, shadow, background, ramp and pan timings, from the project frame block and overridable by NO_FRAME and PADDING. The mat the window sits on is the brand blue: it is most of what the...")
  Component(probe, "Probe", "ffprobe", "Dimensions, frame rate and frame count of the take.")
  Component(cursor_track, "Cursor track", "compose.mjs", "Splits telemetry into moves and clicks, then works out when the cursor actually left one point and settled on the next.")
  Component(zoom_keyframe_track, "Zoom keyframe track", "compose.mjs", "Four keyframes per region — ramp up, hold, hold, ramp down — interpolated with an ease-in-out cubic.")
  Component(cursor_sprites, "Cursor sprites", "@napi-rs/canvas", "Arrow and pointing hand drawn once into sprites, then composited with a press scale and a click ripple.")
  Component(frame_renderer, "Frame renderer", "@napi-rs/canvas", "Per frame: the source into its own canvas, the zoom transform clipped to the rounded window, the shadow, then the cursor on top.")
  Component(decoder_pipe, "Decoder pipe", "ffmpeg rawvideo rgba", "Streams the take in.")
  Component(encoder_pipe, "Encoder pipe", "ffmpeg libx264", "Takes rendered frames straight back, with faststart.")
}

Rel(work_directory, project_reader, "demo.recordly and the take to")
Rel(look_resolver, brand_assets, "Reads colours")
Rel(project_reader, look_resolver, "Frame block to")
Rel(project_reader, probe, "Take path to")
Rel(project_reader, cursor_track, "Cursor telemetry to")
Rel(project_reader, zoom_keyframe_track, "Zoom regions to")
Rel(cursor_track, zoom_keyframe_track, "Leave and arrive times to")
Rel(probe, decoder_pipe, "Geometry and frame rate to")
Rel(decoder_pipe, ffmpeg_ffprobe, "Runs", "child process")
Rel(decoder_pipe, frame_renderer, "Raw RGBA frames to")
Rel(zoom_keyframe_track, frame_renderer, "Zoom and pan per frame to")
Rel(cursor_sprites, frame_renderer, "Cursor sprites to")
Rel(look_resolver, frame_renderer, "Frame styling to")
Rel(frame_renderer, encoder_pipe, "Composited frames to")
Rel(encoder_pipe, ffmpeg_ffprobe, "Runs", "child process")
Rel(encoder_pipe, work_directory, "Writes final.mp4")

LAYOUT_WITH_LEGEND()
@enduml
