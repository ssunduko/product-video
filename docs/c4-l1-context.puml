@startuml c4-l1-context
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Context>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4-L1 — System Context
caption Level 1. The pipeline as one box, with the people who use it and the systems it depends on.

Person(demo_author, "Demo author", "Developer or PM. Writes the flow in plain English or as a .demo script, points it at a deployment with a target, and builds the video: one stage at a time from a shell, or every part of a video wit...")
System(demo_video_pipeline, "Demo Video Pipeline", "Node.js CLI stages. Turns a plain-English flow into a narrated, branded MP4.")
Person(viewer, "Viewer", "Prospect, customer or internal audience.")
System_Ext(google_chrome, "Google Chrome", "Chrome + DevTools Protocol. Driven by puppeteer-core on a dedicated user-data profile — one per target, so a login survives between takes and a video can show two signed-in users without anyone signing in on camera.")
System_Ext(web_application_under_demo, "Web application under demo", "Any web app. The deployment being recorded — localhost, staging, a customer sandbox, or a third-party app such as claude.ai.")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")
System_Ext(text_to_speech_api, "Text-to-speech API", "ElevenLabs or OpenAI. Chosen by DEMO_TTS, or by whichever key is set.")
System_Ext(claude_in_chrome_extension, "Claude in Chrome extension", "Browser extension. Drives the user own Chrome, with their own session, so there is no SSO ritual and no email code to fill.")
System_Ext(video_qa_agent, "video-qa agent", "Claude Code subagent. Reviews a finished video: runs the quality gate, then checks every narration line against a still of the screen — is the thing being described on screen while it is said? — and returns PASS or FAIL...")
System_Ext(memory_agent, "memory agent", "Claude Code subagent. Runs at session start when a feature source is stale: lists each online source of an app with its MCP tool, reads what changed, merges its features into the catalog and pushes them to Zep.")
System_Ext(online_feature_sources, "Online feature sources", "e.g. a Google Drive folder per app. Where the features of each app are published, located by FEATURE_SOURCE_{APP} in .env.")
System_Ext(zep_cloud, "Zep Cloud", "@getzep/zep-cloud · HTTPS. Searchable memory: one graph per app for feature pages, traces and manifests, one for rules and pipeline notes, and a thread per working session.")
System_Ext(video_destination, "Video destination", "Google Drive API v3 · HTTPS. Where finished videos are published: a Google Drive folder per app, located by PUBLISH_DEST_{APP} in .env.")
System_Ext(jira, "Jira", "Atlassian MCP. The ticket each video is for (the manifest names it).")

Rel(demo_author, demo_video_pipeline, "Writes flows and runs the stages", "CLI")
Rel(demo_video_pipeline, claude_in_chrome_extension, "Resolves natural-language selectors before a take via")
Rel(claude_in_chrome_extension, web_application_under_demo, "Inspects the live DOM of", "user session")
Rel(demo_video_pipeline, viewer, "Delivers the finished MP4 to")
Rel(demo_video_pipeline, google_chrome, "Launches and drives", "CDP")
Rel(google_chrome, web_application_under_demo, "Loads and interacts with", "HTTP")
Rel(demo_video_pipeline, ffmpeg_ffprobe, "Encodes, decodes and filters via", "child process")
Rel(demo_video_pipeline, text_to_speech_api, "Renders speech via", "HTTPS")
Rel(video_qa_agent, demo_video_pipeline, "Reviews every video built by")
Rel(demo_video_pipeline, zep_cloud, "Stores feature catalogs, pages, traces and session threads in", "HTTPS")
Rel(demo_video_pipeline, video_destination, "Publishes approved videos to", "HTTPS")
Rel(demo_author, jira, "Posts the published link on the ticket (through Claude)", "MCP")
Rel(memory_agent, online_feature_sources, "Reads new and changed feature files from", "MCP")
Rel(memory_agent, demo_video_pipeline, "Merges features and syncs memory via", "CLI")
Rel(demo_video_pipeline, memory_agent, "Asks for a sync at session start when a source is stale")

LAYOUT_WITH_LEGEND()
@enduml
