@startuml c4-l2-containers
' Generated by docs/c4-model.mjs — do not edit; edit the model and re-run.
!include <C4/C4_Container>
' No bundled C4 stdlib? Replace the line above with:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4-L2 — Containers
caption Level 2. The stages inside the pipeline and the files they hand work over through.

Person(demo_author, "Demo author", "Developer or PM. Writes the flow in plain English or as a .demo script, points it at a deployment with a target, and builds the video: one stage at a time from a shell, or every part of a video wit...")
System_Ext(google_chrome, "Google Chrome", "Chrome + DevTools Protocol. Driven by puppeteer-core on a dedicated user-data profile — one per target, so a login survives between takes and a video can show two signed-in users without anyone signing in on camera.")
System_Ext(web_application_under_demo, "Web application under demo", "Any web app. The deployment being recorded — localhost, staging, a customer sandbox, or a third-party app such as claude.ai.")
System_Ext(claude_in_chrome_extension, "Claude in Chrome extension", "Browser extension. Drives the user own Chrome, with their own session, so there is no SSO ritual and no email code to fill.")
System_Ext(ffmpeg_ffprobe, "ffmpeg / ffprobe", "Local CLI. On PATH, or via FFMPEG / FFPROBE. Every encode, decode, probe and audio filter graph.")
System_Ext(text_to_speech_api, "Text-to-speech API", "ElevenLabs or OpenAI. Chosen by DEMO_TTS, or by whichever key is set.")
System_Ext(video_qa_agent, "video-qa agent", "Claude Code subagent. Reviews a finished video: runs the quality gate, then checks every narration line against a still of the screen — is the thing being described on screen while it is said? — and returns PASS or FAIL...")

System_Boundary(demo_video_pipeline_2, "Demo Video Pipeline") {
  Container(author, "0 · Author", "author.mjs · Node.js", "Turns an observed walk of the app into the DSL. Reads a trace — the selectors found and the wait times measured — and emits the .demo and its selector sidecar together.")
  ContainerDb(observed_traces, "Observed traces", "scenarios/*.trace.json", "What the app actually did on a real walk: the selector each step needs, the evidence for it, and how long every wait took.")
  Container(script_compiler, "1 · Script Compiler", "script.mjs · Node.js", "Compiles a .demo flow into a normal, inspectable scenario module.")
  Container(driver, "2 · Driver", "driver.mjs · Node.js + puppeteer-core", "Launches Chrome, signs in if the target says to, runs the flow, and records a screencast plus cursor, click and narration-cue telemetry, plus the real start and end of every wait.")
  Container(assembler, "3 · Assembler", "assemble.mjs · Node.js + ffmpeg", "Turns frames into raw.mp4 / cut.mp4.")
  Container(zoom_projector, "4 · Zoom Projector", "project.mjs · Node.js", "Clusters clicks less than 2.5s apart into zoom regions, each carrying a focusTrack the compositor pans across, and writes {take}.recordly.")
  Container(compositor, "5 · Compositor", "compose.mjs · Node.js + canvas + ffmpeg", "Renders every frame: eased zoom/pan, a synthesized cursor with click ripples, and a styled window frame.")
  Container(narrator, "6 · Narrator", "narrate.mjs · Node.js + ffmpeg", "Voices the say-cues, trims the breath off each clip, levels every clip to a common loudness, and mixes them onto the video.")
  Container(tightener, "7 · Tightener", "tighten.mjs · Node.js + ffmpeg", "Compresses stretches that are frozen AND silent, trims the trailing run, and crossfades every seam.")
  Container(card_renderer, "8 · Card Renderer", "cards.mjs · Node.js + canvas + ffmpeg", "Renders branded intro/outro title cards, voices them with the same provider, and dissolves them on with the concat filter rather than the demuxer.")
  ContainerDb(flow_definitions, "Flow definitions", "input/ + scenarios/ authored, scripts/ generated", "What happens on screen and what is said over it.")
  ContainerDb(targets_secrets, "Targets & secrets", "targets/*.json, *.local.json, .env", "Which deployment, and how to sign in.")
  ContainerDb(brand_assets, "Brand assets", "brand/", "StyleGuide.txt (colour and type, the source of truth), the logo, and the font files.")
  ContainerDb(work_directory, "Work directory", "out/ · out/{video}/{part}/", "One folder per take: out/ by default, or out/{video}/{part}/ when the build orchestrator sets DEMO_OUT, so takes never overwrite each other.")
  ContainerDb(tts_clip_cache, "TTS clip cache", "out/tts/ · mp3", "One mp3 per line, keyed by provider+voice+text, plus the derived .lead.mp3 with the opening breath trimmed.")
  ContainerDb(selector_resolutions, "Selector resolutions", "scripts/*.selectors.json", "What each ask description resolved to against the live DOM, plus the evidence for it.")
  Container(quality_gate, "9 · Quality Gate", "qa.mjs · Node.js + ffmpeg", "Measures what a viewer notices and a stage only warns about: two narration lines at once, a line off its cue, dead air, a frozen or loading screen, black frames, mismatched streams, loudness, and a...")
  Container(build_orchestrator, "Build Orchestrator", "build.mjs · Node.js + ffmpeg", "Builds a whole video from its manifest: records and renders every part into its own folder, gates each on the quality gate, trims the silence at each join by measurement, crossfades the parts and g...")
  ContainerDb(video_manifests, "Video manifests", "videos/*.json", "One per finished video: its parts in recording order with what must be true before each take, the settings every stage runs with, and how the parts join.")
  ContainerDb(browser_profiles, "Browser profiles", "profile/, profile-*/ · gitignored", "Chrome user-data directories holding signed-in sessions, one per target that needs its own user.")
}

Rel(demo_author, flow_definitions, "Writes the flow")
Rel(demo_author, targets_secrets, "Sets the deployment and credentials")
Rel(demo_author, author, "Runs once to generate the script", "CLI")
Rel(claude_in_chrome_extension, observed_traces, "Writes what it observed and measured")
Rel(author, observed_traces, "Reads the trace")
Rel(author, flow_definitions, "Emits the .demo")
Rel(author, selector_resolutions, "Emits the sidecar, from the same trace")
Rel(script_compiler, flow_definitions, "Compiles .demo, writes the scenario")
Rel(script_compiler, selector_resolutions, "Swaps each ask intent for its resolution")
Rel(claude_in_chrome_extension, selector_resolutions, "Writes what it found")
Rel(claude_in_chrome_extension, flow_definitions, "Reads the ask intents")
Rel(claude_in_chrome_extension, web_application_under_demo, "Inspects the live DOM of", "user session")
Rel(driver, script_compiler, "Compiles a .demo on the way in", "import")
Rel(driver, flow_definitions, "Loads the scenario")
Rel(driver, targets_secrets, "Resolves app URL and credentials")
Rel(driver, google_chrome, "Launches and drives", "CDP")
Rel(google_chrome, web_application_under_demo, "Loads and interacts with", "HTTP")
Rel(driver, work_directory, "Writes frames + telemetry")
Rel(assembler, work_directory, "Frames to MP4; shifts telemetry")
Rel(zoom_projector, work_directory, "Clicks to zoom regions")
Rel(compositor, work_directory, "Take + project to final.mp4")
Rel(compositor, brand_assets, "Reads colours")
Rel(narrator, work_directory, "Muxes narration onto the video")
Rel(narrator, tts_clip_cache, "Caches clips")
Rel(narrator, text_to_speech_api, "Renders speech", "HTTPS")
Rel(tightener, work_directory, "Removes frozen + silent stretches")
Rel(card_renderer, work_directory, "Joins intro/outro cards")
Rel(card_renderer, brand_assets, "Reads logo, colours, fonts")
Rel(card_renderer, tts_clip_cache, "Caches card voice")
Rel(card_renderer, text_to_speech_api, "Renders card voice", "HTTPS")
Rel(assembler, ffmpeg_ffprobe, "Runs", "child process")
Rel(compositor, ffmpeg_ffprobe, "Runs", "child process")
Rel(narrator, ffmpeg_ffprobe, "Runs", "child process")
Rel(tightener, ffmpeg_ffprobe, "Runs", "child process")
Rel(card_renderer, ffmpeg_ffprobe, "Runs", "child process")
Rel(quality_gate, ffmpeg_ffprobe, "Runs", "child process")
Rel(driver, browser_profiles, "Records from the target's signed-in profile")
Rel(demo_author, browser_profiles, "Signs in once by hand")
Rel(assembler, tts_clip_cache, "Reads line lengths for auto-speed")
Rel(quality_gate, work_directory, "Measures the stage outputs; writes the report and stills")
Rel(quality_gate, tts_clip_cache, "Reads line lengths")
Rel(video_qa_agent, quality_gate, "Runs, then reviews the stills")
Rel(demo_author, build_orchestrator, "Runs one build per video", "CLI")
Rel(demo_author, video_manifests, "Writes the manifest")
Rel(build_orchestrator, video_manifests, "Reads")
Rel(build_orchestrator, driver, "Runs per part", "child process")
Rel(build_orchestrator, assembler, "Runs per part", "child process")
Rel(build_orchestrator, zoom_projector, "Runs per part", "child process")
Rel(build_orchestrator, compositor, "Runs per part", "child process")
Rel(build_orchestrator, narrator, "Runs per part", "child process")
Rel(build_orchestrator, tightener, "Runs per part", "child process")
Rel(build_orchestrator, card_renderer, "Runs per part", "child process")
Rel(build_orchestrator, quality_gate, "Runs per part", "child process")
Rel(build_orchestrator, work_directory, "Gives each part its own folder; writes the joined MP4")
Rel(build_orchestrator, ffmpeg_ffprobe, "Measures and joins via", "child process")

LAYOUT_WITH_LEGEND()
@enduml
