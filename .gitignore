# dependencies
node_modules/

# IDE and local Claude Code settings
.idea/
*.iml
.claude/settings.local.json
**/.claude/settings.local.json

# credentials: never commit (.env.example is the template)
.env
.env.*
!.env.example
*.local.json

# renders, frames, narration and TTS cache: regenerable, and they show live
# account data (claude.ai sidebar, Salesmessage analytics)
out/
# signed-in Chrome profile: cookies, saved logins, history
profile/
profile-*/

# commercial font (Hanken Design Co): licence does not allow redistribution
brand/fonts/Hanken Design Co - Neue Einstellung*.otf

# Salesmsg logos and internal page screenshots: keep local, not for a public
# repo. cards.mjs renders title cards without the logo when it is absent.
brand/*.png

# OS / logs
.DS_Store
Thumbs.db
npm-debug.log*
*.log
