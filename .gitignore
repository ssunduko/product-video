# dependencies
node_modules/

# IDE and local Claude Code settings
.idea/
*.iml
.claude/settings.local.json
**/.claude/settings.local.json

# credentials: never commit (.env.example is the template)
.env
.env.*
!.env.example
*.local.json
# Zep graph/episode ids for this machine (memory.mjs)
memory/.zep-state.json

# renders, frames, narration and TTS cache: regenerable, and they show live
# account data (claude.ai sidebar, Salesmessage analytics). The folder itself
# stays in the repo (out/.gitkeep); nothing inside it is ever committed.
out/*
!out/.gitkeep
# signed-in Chrome profile: cookies, saved logins, history
profile/
profile-*/

# commercial font (Hanken Design Co): licence does not allow redistribution
brand/fonts/Hanken Design Co - Neue Einstellung*.otf

# Salesmsg logos and internal page screenshots: keep local, not for a public
# repo. cards.mjs renders title cards without the logo when it is absent.
brand/*.png

# OS / logs
.DS_Store
Thumbs.db
npm-debug.log*
*.log

# Salesmessage assets: never in this public repo. They stay on disk for local
# builds. A trace, script or manifest whose target is gitignored is itself
# private: list it here too (docs/check.mjs fails if one is committed).
targets/salesmessage*.json
input/click-tracking.flow
scenarios/click-tracking.trace.json
scripts/click-tracking.demo
scripts/click-tracking.selectors.json
videos/click-tracking.json
memory/features/salesmessage/
brand/StyleGuide.txt
# model videos are Salesmessage videos; only the folder is kept
sample/*
!sample/.gitkeep
