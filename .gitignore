# dependencies
node_modules/

# IDE and local Claude Code settings
.idea/
*.iml
.claude/settings.local.json
**/.claude/settings.local.json

# credentials: never commit (.env.example is the template)
.env
.env.*
!.env.example
*.local.json
# Zep graph/episode ids for this machine (memory.mjs)
memory/.zep-state.json

# renders, frames, narration and TTS cache: regenerable, and they show live
# account data (signed-in sidebars, analytics). The folder itself
# stays in the repo (out/.gitkeep); nothing inside it is ever committed.
out/*
!out/.gitkeep
# signed-in Chrome profile: cookies, saved logins, history
profile/
profile-*/

# commercial brand fonts dropped at brand/fonts/: licences rarely allow
# redistribution (the open Inter files under brand/fonts/ are committed)
brand/fonts/*.otf

# brand logos and internal page screenshots: keep local, not for a public
# repo. cards.mjs renders title cards without the logo when it is absent.
brand/*.png

# OS / logs
.DS_Store
Thumbs.db
npm-debug.log*
*.log

# private apps: their targets, flows, traces, scripts, manifests and feature
# folders are listed in .git/info/exclude (local, never committed), so this
# public file names none of them. docs/check.mjs fails if a committed trace,
# script or manifest uses a target that is not committed.
# model videos are app videos; only the folder is kept
sample/*
!sample/.gitkeep
