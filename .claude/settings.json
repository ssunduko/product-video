{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/docs/check.mjs\" --hook",
            "timeout": 60,
            "statusMessage": "Checking the docs against the code"
          }
        ]
      }
    ]
  }
}
