# Template for .env — copy it to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored; this file is committed, so keep it free of real values.
# Every key the code reads is listed here, in the same order as .env; keep the
# two in step when you add one.
# Read automatically by target.mjs, narrate.mjs and memory.mjs.

# ---- text to speech (narrate.mjs) ----

# ElevenLabs API key: dashboard -> your profile icon -> API Keys
ELEVENLABS_API_KEY=

# OpenAI API key — alternative provider (cheaper, close in quality).
# OPENAI_API_KEY=

# Which provider to use: elevenlabs | openai. Optional — with only one key
# set, that provider is picked automatically.
DEMO_TTS=

# Voice ID, not the voice *name*. Find it in the ElevenLabs dashboard under
# Voices -> pick a voice -> "ID" (or via the /v1/voices API).
# Leave empty to use the default ("Rachel", 21m00Tcm4TlvDq8ikWAM).
DEMO_TTS_VOICE=

# Presenter avatar (cards.mjs): on or off (empty is off). On, its clips (a script's
# intro-avatar / outro-avatar) voice the cards, and DEMO_AVATAR_VOICE, the
# avatar's ElevenLabs voice ID, reads the narration in place of DEMO_TTS_VOICE.
# Off, everything uses DEMO_TTS_VOICE.
DEMO_AVATAR=
DEMO_AVATAR_VOICE=

# ---- app credentials (target.mjs) ----
# Referenced from a target as "env:DEMO_PASSWORD" etc. Not needed for apps
# that sign in via SSO and use the session in profile/.

# DEMO_APP=https://app.example.com
# DEMO_USERNAME=
# DEMO_PASSWORD=
# DEMO_WORKSPACE_ID=

# ---- target secrets (a target's "secrets") ----
# Internal ids a target fills into URLs at record time, referenced from the
# target as "env:DEMO_MEMBER_ID" etc., so they stay out of committed files.
# Id of the demo member; scripts open /settings/members/{memberId}/...
DEMO_MEMBER_ID=
# Id of a DRAFT test agent; scripts open /chatbot/{agentId}/...
DEMO_AGENT_ID=
# HubSpot portal and workflow ids for a HubSpot target; scripts open /workflows/{portalId}/platform/flow/{flowId}/edit
DEMO_HUBSPOT_PORTAL_ID=
DEMO_HUBSPOT_FLOW_ID=
# Id of a test inbox whose settings a take may change and put back; scripts open /settings/inboxes/{testInboxId}/...
DEMO_TEST_INBOX_ID=

# ---- project memory (memory.mjs) ----

# Online feature source (memory/sources.json): FEATURE_SOURCE, a Google Drive
# folder URL the memory agent reads, and FEATURE_SOURCE_APP, the folder under
# memory/features/ it feeds. No variable is named after an app.
FEATURE_SOURCE=
FEATURE_SOURCE_APP=

# Zep Cloud project API key: app.getzep.com -> project -> API Keys.
# Feature catalogs, video pages, traces, manifests and session notes are stored there.
ZEP_API_KEY=

# Who Claude sessions are attributed to in Zep (one Zep user per person).
# Default: git config user.email.
# MEMORY_USER=you@example.com

# Hours before a remote feature source counts as stale (default 24).
# MEMORY_MAX_AGE_H=24

# ---- publishing (publish.mjs) ----

# Where finished videos are published (memory/destinations.json). Leave one
# unset to skip it.
# PUBLISH_DEST: a Google Drive folder URL.
# PUBLISH_YOUTUBE_CHANNEL: the YouTube channel, as @handle, its URL or its
#   UC... channel id. Uploads are refused unless the signed-in channel is this one.
# PUBLISH_YOUTUBE_THUMBNAIL: a designed thumbnail, as a path with <name> for the
#   video name; when that file is missing the intro title card is used.
PUBLISH_DEST=
PUBLISH_YOUTUBE_CHANNEL=
PUBLISH_YOUTUBE_THUMBNAIL=

# Google OAuth client (Desktop app; enable the Drive API and the YouTube Data
# API v3 in its project), the Drive refresh token `node pipeline/publish.mjs
# auth` writes, and the channel's refresh token `node pipeline/publish.mjs auth
# youtube` writes. Never commit these.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# YouTube privacy when the manifest's "youtube" block sets none: public,
# unlisted or private (default public).
# PUBLISH_YOUTUBE_PRIVACY=public

# YouTube title and audio language when the manifest sets none (default en).
# PUBLISH_YOUTUBE_LANGUAGE=en
