# tell Enhance what to improve, review the result, refine, and accept
#
# Generated by pipeline/author.mjs from an observed walk of the app.
# Holds and narration are sized from what the app ACTUALLY did, not
# from a guess — see the measured comments against each wait.
# Observed: 2026-10-18
#
# Edit freely. Re-running the author overwrites it, so if you change
# a line here, change it in the trace too.
#
# TEST AGENT ONLY. The take ends with the enhanced text in the Instructions field, UNSAVED. It never
# clicks Save or Activate. The driver closes the browser, which drops the change; the ready wait
# fails fast if a refund rule was ever saved.
#
# profile/ must hold the admin session, and SALESMSG_DEMO_AGENT_ID in .env must name a draft test agent.
#
# Enhance calls a model: each result differs, and Recommendations may not appear at all, so the
# narration names only what the chips and notes asked for. Each line is said while that result is on screen.
#
# Rebuilt from qa 2026-10-18 (7 fail): lines now play OVER the clicks, typing and scrolls they describe
# (sayOver: only the part of a line the measured actions do not cover is held), fewer scrolls, motion
# under the opening lines, holds at 72ms/char (TTS measured ~65ms/char). Typing in the modal runs
# ~0.25s a character, so the notes are short: a long note is seconds of near-frozen picture.

name: enhance-agent-instructions
description: tell Enhance what to improve, review the result, refine, and accept
target: salesmessage
start: /chatbot/{agentId}/config
intro: Enhance agent instructions | Choose what to improve, then review before you accept
outro: Thanks for watching | Questions? Reach out any time - we are happy to help

# Stated as intent; resolved against the live DOM into the sidecar beside
# this file. Re-resolve after a redesign — this script does not change.
selectors:
  ready          = ask "the agent's Instructions field holding the starting version (no refund rule yet)"
  instructions   = ask "the agent's Instructions field"
  enhanceOpen    = ask "the Enhance link above the Instructions field"
  ageChip        = ask "the Age restriction chip in the Enhance modal"
  competitorChip = ask "the Competitor mentions chip in the Enhance modal"
  goalChip       = ask "the Clearer goal chip in the Enhance modal"
  note           = ask "the custom note box in the Enhance modal"
  modalEnhance   = ask "the Enhance button at the bottom of the modal's first step"
  current        = ask "the current instructions panel on the left of the result"
  resultReady    = ask "the Refine button, shown only once the enhanced version is ready"
  enhanced       = ask "the enhanced instructions panel on the right of the result"
  refine         = ask "the Refine button under the result"
  likeIt         = ask "the I like it button under the result"
  accepted       = ask "the Instructions field now holding the enhanced text with the refund rule"
  saveChanges    = ask "the Save changes button at the top of the editor"

beat The starting instructions
  wait @ready within 30s
  hold 0.8s
  hover @instructions
  hold 0.3s
  say "Here are this agent's instructions - the starting version, with no rules yet for age, competitors or refunds."
  scroll down 250
  hold 2.2s
  scroll down 250
  hold 2.2s
  hover @enhanceOpen
  hold 1.2s
  hold 1.5s
  say "Enhance no longer rewrites them straight away. First, it asks what to improve."
  hold 1.2s
  click @enhanceOpen
  wait @ageChip within 10s
  hold 3s
  hold 1.2s

beat Choose what to improve
  say "Nothing is generated yet. Pick any of three improvements, add a note of your own, or both."
  hold 6.5s
  say "I'll ask for all three: an age restriction, competitor mentions, and a clearer goal."
  click @ageChip
  hold 0.3s
  click @competitorChip
  hold 0.3s
  click @goalChip
  hold 1.7s
  say "Plus a note in my own words. Here, I'm asking for one more rule: how to handle customer complaints."
  type "Add a rule for complaints" into @note
  hold 1.7s
  click @modalEnhance
  say "Enhance rewrites the instructions with exactly those changes."
  hover @current
  scroll down 300
  hold 1.5s
  wait @resultReady within 21s

beat Review before you accept
  hold 0.3s
  hover @current
  say "The current instructions stay on the left, so you can compare."
  scroll down 300
  hold 1.5s
  scroll down 300
  hold 1.5s
  hold 0.9s
  hover @enhanced
  say "On the right, the new version: an age check, a competitor rule, a clear main goal, and the complaints rule you asked for."
  hold 1s
  scroll down 500
  hold 2s
  scroll down 500
  hold 2s
  scroll down 500
  hold 1.8s
  scroll down 500
  hold 1.2s
  hold 0.4s
  hover @refine
  say "Not quite right? Refine goes back a step, with your choices still in place."
  hold 1.5s
  click @refine
  wait @competitorChip within 10s
  hold 3s
  hold 0.3s

beat Refine
  say "This time, I'll drop the competitor rule, and ask for a refund rule instead of complaints."
  click @competitorChip
  hold 0.3s
  type "Add a rule for refunds" into @note
  hold 0.3s
  click @modalEnhance
  say "Enhance builds a fresh version from the new choices."
  hold 3.8s
  wait @resultReady within 28s
  hold 0.3s
  hover @enhanced
  say "The new version keeps the age check and the goal, and now covers refunds."
  hold 0.6s
  scroll down 500
  hold 2s
  scroll down 500
  hold 1.8s
  hold 0.3s

beat Accept
  hover @likeIt
  say "Happy with it? I like it puts the enhanced text into the Instructions field."
  hold 1.8s
  click @likeIt
  wait @accepted within 10s
  hover @instructions
  hold 0.8s
  hold 0.3s
  hover @saveChanges
  hold 0.3s
  say "Nothing changes for your contacts until you save - review it, then save when you're ready."
  hold 6.5s
  hold 0.6s
