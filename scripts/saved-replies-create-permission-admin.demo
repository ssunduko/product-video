# part 1 of 2 - the admin restricts one member to using Saved Replies without creating them
#
# Generated by pipeline/author.mjs from an observed walk of the app.
# Holds and narration are sized from what the app ACTUALLY did, not
# from a guess — see the measured comments against each wait.
# Observed: 2026-10-17
#
# Edit freely. Re-running the author overwrites it, so if you change
# a line here, change it in the trace too.
#
# PART 1 OF 2. Part 2 is scenarios/saved-replies-create-permission-member.trace.json; the two finished
# clips are joined into one video. Splitting removes the on-camera sign-in, which hit a 2FA
# enrolment dialog and a reCAPTCHA.
#
# BEFORE EVERY TAKE: Demo Demo's 'Can create Saved Replies' must be ON. The take turns it OFF, and
# the first wait (#cannedMessage:checked) fails fast if it is already off.
#
# profile/ must hold the admin session (Google SSO, signed in by hand). Takes no longer log it out.
#
# Rebuilt from video-qa 2026-10-17: line holds sized from measured TTS length (no overlaps); every line said only once its subject is on screen; the take starts on the loaded Role & Permissions page; the member-page load is left silent so tighten.mjs fast-forwards it.

name: saved-replies-create-permission-admin
description: part 1 of 2 - the admin restricts one member to using Saved Replies without creating them
target: salesmessage
intro: Saved Replies permissions | Let your team use replies without adding new ones

# Stated as intent; resolved against the live DOM into the sidecar beside
# this file. Re-resolve after a redesign — this script does not change.
selectors:
  ready            = ask "the Member checkbox in the Saved Replies access row, proving Role & Permissions has loaded"
  roleCreateMember = ask "the Member checkbox in the 'Can create Saved Replies' row"
  roleAccessMember = ask "the Member checkbox in the 'Can access Saved Replies' row"
  memberCreate     = ask "the checked 'Can create Saved Replies' checkbox on the member's own Permissions page"
  createOff        = ask "the unchecked 'Can create Saved Replies' checkbox, right after clicking it"
  saveBar          = ask "the Save button in the Cancel / Save bar that appears once a permission changes"
  savedToast       = ask "the close button on the 'Permissions updated' toast"

beat Two Saved Replies permissions
  wait @ready within 10s
  hold 0.8s
  hover @roleCreateMember
  hold 0.4s
  say "Saved Replies now have two separate permissions: access, and create."
  hold 5s
  say "Access lets someone find and insert replies. Create lets them add, edit, duplicate and delete."
  hold 7.6s
  hover @roleAccessMember
  hold 0.3s
  say "Turning access off takes create with it - create depends on access."
  hold 4.7s

beat Restrict one member
  open /settings/members/{memberId}/permissions
  wait @memberCreate within 36s
  hover @memberCreate
  hold 0.5s
  say "The same two settings exist for each member, and they override the role."
  hold 5.3s
  say "This member keeps access, but loses create."
  hold 1.5s
  click @memberCreate
  wait @createOff within 10s
  hold 0.9s
  wait @saveBar within 10s
  click @saveBar
  wait @savedToast within 10s
  say "Saved. Access on, create off."
  hold 2.9s
  click @savedToast
  hold 0.3s
