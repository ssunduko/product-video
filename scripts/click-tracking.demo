# Click tracking analytics - the link grid, one link's detail page, and the sources view (SWR-11033)
#
# Generated by pipeline/author.mjs from an observed walk of the app.
# Holds and narration are sized from what the app ACTUALLY did, not
# from a guess — see the measured comments against each wait.
# Observed: 2026-10-18
#
# Do not edit: change the trace and re-run the author. `node author.mjs
# --check` (pre-commit and CI) fails while this file and its trace disagree.
#
# The prepared link is short code NIqoQk (https://salesmsg.org/NIqoQk, Campaign 'Analytics Campaign', 3 clicks, link id 834033).
# If that link is deleted or the account changes, update the type step and re-walk.
#
# The Contacts tab shows the recipient's real name, phone number and email on camera. Use a demo contact before publishing.
#
# Search is debounced: the grid empties, then the single match returns ~1.4s after the last keystroke.
# The old rows match `gridRow` until then, so the take waits on `gridOneRow` (tbody tr:only-child) instead.
#
# Load times vary a lot: Sources 0.8s-11.9s, the Overview grid 1.5s-8.8s, the detail page 0.85s-3.5s, and twice the app stalled outright
# (Sources empty for 32s+, the detail page spinning 10s+). Timeouts are sized from the slow loads; if a take aborts on a wait, check the app before changing the script.
#
# The Aircall 'integration disconnected' banner across the top is hidden by the target's hideSelectors.
#
# A 'Plan credits exceeded!' alert pops up bottom-left in profile/ about 11s after load and stays for the whole take.
# One 1s ifAppears guard at 'Find one link' (~30s in) closes it; if it shows, it is on screen from ~11s until then.
# Closing it snoozes it for 30 days in profile/ (localStorage subscription_credits_alert_closed_at_<user>), so usually the guard does not fire.
# No guard at the start: the take begins ~3s after load, before the alert can appear, and a start guard only adds a frozen, silent opening (failed qa twice).

name: click-tracking
description: Click tracking analytics - the link grid, one link's detail page, and the sources view (SWR-11033)
target: salesmessage
start: /conversations/
intro: Click tracking | See who clicks the links you send
outro: Thanks for watching | Questions? Reach out any time - we are happy to help

# Stated as intent; resolved against the live DOM into the sidecar beside
# this file. Re-resolve after a redesign — this script does not change.
selectors:
  ready              = ask "the Analytics icon in the far-left app sidebar, proving the app shell has loaded"
  navAnalytics       = ask "the Analytics icon in the far-left app sidebar"
  ctOverview         = ask "the Overview item under Click tracking in the Analytics menu"
  clickTrackingLabel = ask "the 'Click tracking' group heading in the Analytics menu"
  gridRow            = ask "a row in the Click tracking overview grid"
  colSent            = ask "the Sent column heading in the overview grid"
  colClicks          = ask "the Clicks column heading in the overview grid"
  colUnique          = ask "the Unique clicks column heading in the overview grid"
  colRate            = ask "the Unique click rate column heading in the overview grid"
  search             = ask "the search box above the overview grid"
  creditsAlert       = ask "the 'Plan credits exceeded!' alert in the bottom-left corner"
  creditsAlertClose  = ask "the close (x) button on the 'Plan credits exceeded!' alert"
  gridOneRow         = ask "the overview grid holding exactly one row, after a search narrows it"
  rowOpen            = ask "the Unique clicks cell of the first grid row, which opens the link's detail page"
  detailShortUrl     = ask "the short link shown under the destination in the link detail header"
  detailTitle        = ask "the destination URL heading at the top of the link detail page"
  tileCredits        = ask "the Credits per click tile, the last of the five"
  tileSent           = ask "the Total sent tile on the link detail page"
  tileClicks         = ask "the Total clicks tile on the link detail page"
  tileUnique         = ask "the Unique clicks tile on the link detail page"
  tileRate           = ask "the Unique click rate tile on the link detail page"
  countryChart       = ask "the Countries by clicks chart on the link detail page"
  deviceChart        = ask "the Device type by clicks chart on the link detail page"
  countryBar         = ask "the first country segment in the Countries bar"
  countryTooltip     = ask "the tooltip naming the country and its clicks while a country segment is hovered"
  tabUsage           = ask "the Usage tab below the charts"
  usageRow           = ask "a source row in the Usage table, with its own figures"
  tabContacts        = ask "the Contacts tab below the charts"
  contactsSendTime   = ask "the Send time column heading in the Contacts list"
  contactRow         = ask "a recipient's name in the Contacts list"
  ctSources          = ask "the Sources item under Click tracking in the Analytics menu"
  sourcesTiles       = ask "the four summary tiles at the top of Click tracking: Sources"
  sourcesRow         = ask "a source record row on Click tracking: Sources"
  sourcesTileValue   = ask "a filled-in number in the Click tracking: Sources summary tiles"
  sourcesLoading     = ask "the loading spinner over the Click tracking: Sources table"

beat Open Analytics
  wait @ready within 10s
  hold 0.2s
  say "Open Analytics."
  click @navAnalytics
  wait @ctOverview within 10s
  say "Here is where you will find click tracking, with Overview and Sources beneath it."
  hover @clickTrackingLabel
  hold 5s

beat The link grid
  say "Start with Overview."
  click @ctOverview
  wait @gridRow within 27s
  hold 0.5s
  say "Overview lists one row for every short link you've delivered."
  hold 3.8s
  say "Each row carries four figures: sent, clicks, unique clicks, and the unique click rate."
  hold 1.8s
  hover @colSent
  hover @colClicks
  hold 0.3s
  hover @colUnique
  hold 1.1s
  hover @colRate
  hold 0.3s

beat Find one link
  hover @search
  say "To find one link, search by its short code."
  if @creditsAlert appears within 1s
    click @creditsAlertClose
    hold 0.6s
  end
  type "NIqoQk" into @search
  wait @gridOneRow within 10s
  say "One row comes back. Open it."
  hold 1.2s

beat Link detail
  click @rowOpen
  wait @detailShortUrl within 11s
  hold 0.5s
  say "The header shows where the link goes, with the short link right beneath it."
  hover @detailTitle
  hold 5.4s
  wait @tileCredits within 10s
  say "Five tiles sum it up: total sent, total clicks, unique clicks, unique click rate, and credits per click."
  hold 1.1s
  hover @tileSent
  hold 0.4s
  hover @tileClicks
  hold 0.7s
  hover @tileUnique
  hold 0.7s
  hover @tileRate
  hold 1.6s
  hover @tileCredits
  hold 0.7s
  hover @countryChart
  say "Below them, clicks are broken down by country"
  hold 3.4s
  hover @deviceChart
  say "and by device type."
  hold 1.2s
  hover @countryBar
  wait @countryTooltip within 10s
  say "Hover a country to see its name and how many clicks came from it."
  hold 4.2s

beat Usage and contacts
  click @tabUsage
  wait @usageRow within 10s
  say "The Usage tab lists each source that delivered the link, each with its own figures."
  hold 6.2s
  click @tabContacts
  wait @contactsSendTime within 10s
  wait @contactRow within 10s
  say "Contacts shows who received it, and when."
  hold 2.7s

beat Sources
  say "Last stop: Sources."
  click @ctSources
  wait @sourcesTiles within 10s
  wait @sourcesRow within 32s
  wait @sourcesTileValue within 12s
  # measured 3.5s here; 0.0s of it is narrated
  wait @sourcesLoading gone within 60s
  hover @sourcesTiles
  hold 0.6s
  say "Sources turns it around, by what sent the links."
  hold 3.3s
  say "Four tiles up top, and one row for every broadcast, campaign or workflow that carried a link."
  hold 7.4s
