# part 2 of 2 - the restricted member can use Saved Replies but not create them
#
# Generated by pipeline/author.mjs from an observed walk of the app.
# Holds and narration are sized from what the app ACTUALLY did, not
# from a guess — see the measured comments against each wait.
# Observed: 2026-10-17
#
# Edit freely. Re-running the author overwrites it, so if you change
# a line here, change it in the trace too.
#
# PART 2 OF 2. Part 1 is scenarios/saved-replies-create-permission-admin.trace.json.
#
# Demo Demo's 'Can create Saved Replies' must be OFF (part 1 leaves it that way) - otherwise Create is
# enabled and the take records the opposite of the story.
#
# profile-member/ must hold the member session (signed in by hand once).
#
# Rebuilt from video-qa 2026-10-17: line holds sized from measured TTS length; narration waits for loaded content (picker list, settings list), not for the empty shell.

name: saved-replies-create-permission-member
description: part 2 of 2 - the restricted member can use Saved Replies but not create them
target: salesmessage-member
outro: Thanks for watching | Questions? Reach out any time - we are happy to help

# Stated as intent; resolved against the live DOM into the sidecar beside
# this file. Re-resolve after a redesign — this script does not change.
selectors:
  ready              = ask "the New message button, proving Conversations has loaded"
  newMessage         = ask "the New message button on the Conversations page"
  composer           = ask "the message box in the composer"
  savedRepliesButton = ask "the Saved replies icon in the message composer toolbar"
  pickerLoaded       = ask "a reply in the Saved replies picker list, proving the list has loaded"
  pickerCreate       = ask "the Create button in the Saved replies picker"
  pickerSearch       = ask "the search box in the Saved replies picker"
  pickerResult       = ask "the 'For the Demo' reply in the picker results"
  pickerOpen         = ask "the Saved replies picker dialog"
  pageLoaded         = ask "a reply in the Saved replies settings list, proving the page has loaded"
  newReply           = ask "the New reply button on the Saved replies settings page"
  duplicate          = ask "the disabled Duplicate button in the reply detail panel"

beat The same app, as that member
  wait @ready within 10s
  hold 0.6s
  say "Now the same app, as that member."
  hold 2.6s

beat Use replies, but not create them
  click @newMessage
  wait @composer within 10s
  wait @savedRepliesButton within 10s
  hover @savedRepliesButton
  hold 0.3s
  say "Saved Replies open right from the message box."
  hold 1.2s
  click @savedRepliesButton
  wait @pickerLoaded within 10s
  say "Every shared reply is still here."
  hold 2.6s
  hover @pickerCreate
  hold 0.4s
  say "But Create and Manage are disabled - contact your admin to enable saved reply management."
  hold 5.9s
  click @pickerSearch
  type "Demo" into @pickerSearch
  hold 1.5s
  say "Search narrows it down instantly."
  hold 2.4s
  wait @pickerResult within 10s
  click @pickerResult
  # measured 0.6s here; 0.0s of it is narrated
  wait @pickerOpen gone within 60s
  hover @composer
  hold 0.3s
  say "One click drops it straight into the message."
  hold 3.2s

beat The Saved Replies page
  open /settings/saved-replies
  wait @pageLoaded within 18s
  hold 0.4s
  say "On the Saved Replies page, the library is visible but read-only."
  hold 2.5s
  hover @newReply
  hold 2.4s
  say "New reply and Duplicate are disabled, and there is no edit or delete."
  hold 2.2s
  hover @duplicate
  hold 3.2s
  say "Members use the curated library. Admins decide what goes in it."
  hold 4.4s
