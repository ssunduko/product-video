# trace tour - every trace step op, recorded against the local Express app
#
# Generated by pipeline/author.mjs from an observed walk of the app.
# Holds and narration are sized from what the app ACTUALLY did, not
# from a guess — see the measured comments against each wait.
# Observed: 2026-10-18
#
# Do not edit: change the trace and re-run the author. `node author.mjs
# --check` (pre-commit and CI) fails while this file and its trace disagree.
#
# Warnings are hazards the walk found that the script cannot express. Each one is copied
# into the header of the generated .demo, so the next person to record reads it.
#
# BEFORE EVERY TAKE: start the sample app (cd sample-app && npm start) so localhost:3000 answers.

name: grammar-tour-trace
description: trace tour - every trace step op, recorded against the local Express app
target: local-app
viewport: 1440x810
start: /
intro: Trace tour | Every step a trace can hold
outro: Thanks for watching | Now write your own flow in input/

# Stated as intent; resolved against the live DOM into the sidecar beside
# this file. Re-resolve after a redesign — this script does not change.
selectors:
  ready        = ask "the welcome paragraph under the main heading, proving the page has loaded"
  heading      = ask "the main page heading"
  cookieAccept = ask "the Accept button on a cookie banner, if one shows"

beat Landing page
  wait @ready within 10s
  hold 0.8s
  say "This is the sample app: one heading and one line of text."
  hold 4.7s

beat Point at things
  hover @heading
  hold 0.3s
  say "A hover points at something without zooming in."
  hold 3.6s
  click @heading
  say "A click zooms in on where it lands."
  hold 2.7s
  scroll down 240
  hold 0.8s
  scroll up 240
  press Tab
  hold 0.6s

beat Open a page directly
  open /
  wait @ready within 10s
  hold 0.5s

beat Guard for something that only sometimes appears
  if @cookieAccept appears within 2s
    click @cookieAccept
    hold 0.5s
  end

beat Settle
  say "That is every step a trace can hold."
  hold 3.5s
